# ruflo writes runtime state into the working directory it is invoked from, and
# ignores CLAUDE_FLOW_DATA_DIR / CLAUDE_FLOW_SWARM_DIR / RUFLO_STATE_DIR when it
# does. The MCP server is registered at user scope, so any ruflo tool call from
# this repo drops these here.
/.claude-flow/
/.swarm/
/ruvector.db
.vercel
# Added by code-review-graph
.code-review-graph/

# A vendored toolchain, not source: 1.6 GB across ~32,000 files, including
# Postgres binaries. Git is the wrong place for it and GitHub would refuse it.
/my-agent/

# Editor and tooling backups
*.bak
