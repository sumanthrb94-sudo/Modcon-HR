rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'admin';
    }

    // Super admins can see/create organizations and are not scoped to any
    // single org (see src/lib/auth.tsx SUPER_ADMIN_EMAILS).
    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().superAdmin == true;
    }

    // An HR Manager administers their own organisation's people data. They hold
    // the same reach as an admin over the collections below, but are not
    // platform admins: they can never grant the `admin` role, touch an admin's
    // profile, or become a super admin. See isOrgAdmin() and the /users rules.
    function isHR() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'hr';
    }

    // Administrators of an organisation: platform admins and HR managers.
    function isOrgAdmin() {
      return isAdmin() || isHR();
    }

    // The caller's own organisation. Null for super admins and for the
    // legacy/default-org accounts that predate multi-org support, which is the
    // same value those orgs' user documents carry — so the comparisons in
    // /users below match default-org users for a default-org HR manager.
    function myOrgId() {
      return myProfile().get('orgId', null);
    }

    // Managers, HR and admins can act on approval workflows.
    function isManager() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (myProfile().role == 'manager' || myProfile().role == 'hr' || myProfile().role == 'admin');
    }

    // Mirrors src/lib/auth.tsx ADMIN_EMAILS / SUPER_ADMIN_EMAILS (prod emails
    // only — E2E test emails are a client-side-only gate and are never
    // trusted here). Used so a self-write can never grant elevated access:
    // see selfCreateRoleIsValid / selfUpdateRoleIsValid below.
    function fixedAdminEmails() {
      return ['sumanthbolla97@gmail.com', 'saikrishnakoppaka@gmail.com', 'info@modconbuilders.com'];
    }
    function fixedSuperAdminEmails() {
      return ['saikrishnakoppaka@gmail.com'];
    }
    function fixedRoleForEmail(email) {
      return email in fixedAdminEmails() ? 'admin' : 'employee';
    }

    // First-ever profile doc for an account: role/superAdmin must be the
    // safe default unless the caller's own email is hard-coded — a brand
    // new sign-up can never self-register as admin/super-admin.
    function selfCreateRoleIsValid(data) {
      let email = request.auth.token.email.lower();
      return data.role == fixedRoleForEmail(email) &&
        data.get('superAdmin', false) == (email in fixedSuperAdminEmails());
    }

    // Resyncing an existing profile on a later sign-in: role/superAdmin may
    // only be what the fixed lists dictate, or left exactly as it already
    // was. A self-write can therefore never escalate past either baseline —
    // any actual promotion (e.g. Admin Dashboard granting `manager`) has to
    // land in the doc via an isAdmin() write first, and self-writes only
    // ever re-affirm it afterwards.
    function selfUpdateRoleIsValid(data) {
      let email = request.auth.token.email.lower();
      return (data.role == fixedRoleForEmail(email) || data.role == resource.data.role) &&
        (data.get('superAdmin', false) == (email in fixedSuperAdminEmails()) ||
          data.get('superAdmin', false) == resource.data.get('superAdmin', false));
    }

    // -------------------------------------------------------------------
    // Users directory (roles, profile info)
    // -------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      // Users may create/update their own profile (first login upsert), but
      // never with a self-granted role/superAdmin, and never a self-assigned
      // orgId (orgId is only ever set by an admin, e.g. org provisioning —
      // letting a user pick their own orgId would let them read any org's
      // record via the /organizations rule below).
      // Admins may create/update anyone else's profile — e.g. to change
      // roles, or when a super admin provisions a new org's admin — but
      // granting/revoking superAdmin itself is reserved to super admins.
      // The HR-manager branches are deliberately separate from the admin ones
      // rather than folded in behind isOrgAdmin(). An HR manager administers
      // one organisation, so on top of never granting `admin` or `superAdmin`
      // they may only act on users already in their own org, and may never
      // write an orgId — including onto their own profile, which would
      // otherwise move them into another company's data namespace and grant
      // read of its /organizations record.
      allow create: if isSignedIn() && (
        (request.auth.uid == uid &&
          selfCreateRoleIsValid(request.resource.data) &&
          !('orgId' in request.resource.data)) ||
        (isAdmin() && (request.resource.data.get('superAdmin', false) == false || isSuperAdmin())) ||
        (isHR() &&
          request.resource.data.role != 'admin' &&
          request.resource.data.get('superAdmin', false) == false &&
          request.resource.data.get('orgId', null) == myOrgId())
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == uid &&
          selfUpdateRoleIsValid(request.resource.data) &&
          request.resource.data.get('orgId', null) == resource.data.get('orgId', null)) ||
        (isAdmin() && (
          request.resource.data.get('superAdmin', false) == resource.data.get('superAdmin', false) ||
          isSuperAdmin()
        )) ||
        (isHR() &&
          // Cannot grant the admin role, nor edit anyone who already holds it —
          // so no self-promotion, and no demoting the admin who could undo it.
          request.resource.data.role != 'admin' &&
          resource.data.role != 'admin' &&
          request.resource.data.get('superAdmin', false) == false &&
          resource.data.get('superAdmin', false) == false &&
          // Target is in my org, and its orgId is left exactly as it was.
          resource.data.get('orgId', null) == myOrgId() &&
          request.resource.data.get('orgId', null) == resource.data.get('orgId', null))
      );
      // Admins can delete anyone. An HR manager may remove a user from their own
      // organisation, but never an admin. Profiles whose email is a fixed admin
      // are additionally protected in-app.
      allow delete: if isAdmin() ||
        (isHR() && resource.data.role != 'admin' && resource.data.get('orgId', null) == myOrgId());
    }

    // -------------------------------------------------------------------
    // Organizations — super-admin managed. Each org's own admin can read
    // (but not modify) their org's record.
    // -------------------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if isSignedIn() && (isSuperAdmin() || myProfile().orgId == orgId);
      allow create: if isSuperAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 &&
        request.resource.data.adminEmail is string &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------
    // Core HR data — read: any signed-in user, write: organisation
    // administrators (admins and HR managers, see isOrgAdmin()).
    // Adjust per-collection if employees need to self-service specific
    // actions (e.g. submitting their own leave/expense requests).
    // -------------------------------------------------------------------
    match /employees/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    // Salary data lives in its own admin-only collection, split out of the
    // broadly-readable `employees` directory (see src/lib/seed.ts).
    match /employee_compensation/{docId} {
      allow read: if isOrgAdmin();
      allow write: if isOrgAdmin();
    }

    match /attendance/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /leave_requests/{docId} {
      allow read: if isSignedIn();
      // Employees can create/update their own leave requests; admins can
      // manage all of them (e.g. approve/reject).
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.employeeId == request.auth.uid || isManager());
      allow delete: if isOrgAdmin();
    }

    match /leave_balances/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /payslips/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /payroll_runs/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /jobs/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /candidates/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /onboarding/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /goals/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /performance_reviews/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /expenses/{docId} {
      allow read: if isSignedIn();
      // Employees can submit/edit their own expense claims; admins manage all.
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.employeeId == request.auth.uid || isManager());
      allow delete: if isOrgAdmin();
    }

    match /assets/{docId} {
      allow read: if isSignedIn();
      allow write: if isOrgAdmin();
    }

    match /billing_preferences/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /billing_invoices/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /helpdesk_tickets/{docId} {
      allow read: if isSignedIn();
      // Employees can raise/update their own tickets; admins manage all.
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.raisedById == request.auth.uid || isOrgAdmin());
      allow delete: if isOrgAdmin();
    }

    match /regularizations/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.employeeId == request.auth.uid || isManager());
      allow delete: if isOrgAdmin();
    }

    // -------------------------------------------------------------------
    // Deny everything else by default.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
