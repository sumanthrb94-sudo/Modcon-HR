rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'admin';
    }

    // Super admins can see/create organizations and are not scoped to any
    // single org (see src/lib/auth.tsx SUPER_ADMIN_EMAILS).
    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().superAdmin == true;
    }

    // An HR Manager administers their own organisation's people data. They hold
    // the same reach as an admin over the collections below, but are not
    // platform admins: they can never grant the `admin` role, touch an admin's
    // profile, or become a super admin. See isOrgAdmin() and the /users rules.
    function isHR() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'hr';
    }

    // Administrators of an organisation: platform admins and HR managers.
    function isOrgAdmin() {
      return isAdmin() || isHR();
    }

    // The caller's own organisation. Null for super admins and for the
    // legacy/default-org accounts that predate multi-org support, which is the
    // same value those orgs' user documents carry — so the comparisons in
    // /users below match default-org users for a default-org HR manager.
    function myOrgId() {
      return myProfile().get('orgId', null);
    }

    // -------------------------------------------------------------------
    // Which employee record a signed-in account *is*.
    //
    // Salary and leave documents are keyed by employeeId (`emp-001`), while
    // rules only ever see `request.auth.uid`. Nothing connected the two, which
    // is why the `resource.data.employeeId == request.auth.uid` checks written
    // elsewhere in this file have never once evaluated true — they compare
    // `emp-009` to a Firebase uid.
    //
    // Employee.authUid exists but lives in localStorage, so it is a claim the
    // client controls and could not be trusted here. The link is therefore an
    // administrator-authored document, exactly like /role_assignments: the
    // client does not say who it is, it discovers who an administrator said it
    // is. See /employee_links below and docs/salary-leave-access-spec.md §3.
    // -------------------------------------------------------------------
    function myEmployeeId() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/employee_links/$(request.auth.uid))
          ? get(/databases/$(database)/documents/employee_links/$(request.auth.uid)).data.employeeId
          : null;
    }

    /** True when `employeeId` is the caller's own employee record. */
    function isSelf(employeeId) {
      return employeeId != null && employeeId == myEmployeeId();
    }

    /**
     * True when the caller is above `record` in the reporting tree.
     *
     * `managerChainIds` is denormalised onto the record at write time (see
     * src/lib/seed.ts): rules cannot walk `reportingManagerId`, because the
     * employee directory it lives in is localStorage-backed and unreadable
     * here. Without this, the only expressible tiers would be "own record" and
     * "any manager in the company", the latter being far wider than the
     * visibility rule in src/lib/dataScope.ts.
     */
    function managesSubject(record) {
      return myEmployeeId() != null &&
        myEmployeeId() in record.get('managerChainIds', []);
    }

    // -------------------------------------------------------------------
    // Multi-tenancy.
    //
    // Every data document carries an `orgId`, and every read and write is
    // scoped to the caller's own organisation. Before this, most collections
    // were `allow read: if isSignedIn()` with no orgId at all, so one company's
    // HR could read another company's employees, payroll and expenses.
    //
    // The key is a string, never null: accounts with no `orgId` — super admins
    // and the accounts predating multi-org support — resolve to 'default',
    // matching DEFAULT_ORG_KEY in src/lib/orgScope.ts and the same convention
    // the handbook already uses. A string is required because Firestore
    // equality filters do not match documents that are missing the field, so
    // `where('orgId','==',null)` would return nothing for un-backfilled data;
    // see the backfill in src/lib/orgBackfill.ts.
    // -------------------------------------------------------------------
    function myOrgKey() {
      return myOrgId() == null ? 'default' : myOrgId();
    }

    /**
     * True when the stored document belongs to the caller's organisation.
     *
     * Documents missing `orgId` are read as 'default' so legacy data stays
     * readable by the legacy org while the backfill runs, rather than every
     * existing record vanishing the moment these rules deploy.
     */
    function inMyOrg() {
      return isSuperAdmin() || resource.data.get('orgId', 'default') == myOrgKey();
    }

    /** True when the document being written is stamped with the caller's org. */
    function writingToMyOrg() {
      return isSuperAdmin() || request.resource.data.get('orgId', 'default') == myOrgKey();
    }

    // Managers, HR and admins can act on approval workflows.
    function isManager() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (myProfile().role == 'manager' || myProfile().role == 'hr' || myProfile().role == 'admin');
    }

    // Mirrors src/lib/auth.tsx ADMIN_EMAILS / SUPER_ADMIN_EMAILS (prod emails
    // only — E2E test emails are a client-side-only gate and are never
    // trusted here). Used so a self-write can never grant elevated access:
    // see selfCreateRoleIsValid / selfUpdateRoleIsValid below.
    function fixedAdminEmails() {
      return ['sumanthbolla97@gmail.com', 'saikrishnakoppaka@gmail.com', 'info@modconbuilders.com'];
    }
    function fixedSuperAdminEmails() {
      return ['saikrishnakoppaka@gmail.com'];
    }
    function fixedRoleForEmail(email) {
      return email in fixedAdminEmails() ? 'admin' : 'employee';
    }

    // A role an administrator has already granted to this email, recorded in
    // /role_assignments (written only by org admins — see that block below).
    // This is what lets an HR employee pick up their role on first sign-in
    // without the client being trusted to name its own role: the grant is a
    // document an admin authored, and the check happens here on the server.
    // `admin` is deliberately not adoptable this way — it is not something the
    // employee-directory flow hands out.
    function assignedRoleFor(email) {
      return exists(/databases/$(database)/documents/role_assignments/$(email))
        ? get(/databases/$(database)/documents/role_assignments/$(email)).data.role
        : null;
    }
    function isAdoptableAssignedRole(email, role) {
      return role == assignedRoleFor(email) && (role == 'hr' || role == 'manager' || role == 'employee');
    }

    // First-ever profile doc for an account: role/superAdmin must be the
    // safe default, a role an administrator assigned to this email, or the
    // value dictated by the hard-coded lists — a brand new sign-up can never
    // self-register as admin/super-admin.
    function selfCreateRoleIsValid(data) {
      let email = request.auth.token.email.lower();
      return (data.role == fixedRoleForEmail(email) ||
          isAdoptableAssignedRole(email, data.role)) &&
        data.get('superAdmin', false) == (email in fixedSuperAdminEmails());
    }

    // Resyncing an existing profile on a later sign-in: role/superAdmin may
    // only be what the fixed lists dictate, or left exactly as it already
    // was. A self-write can therefore never escalate past either baseline —
    // any actual promotion (e.g. Admin Dashboard granting `manager`) has to
    // land in the doc via an isAdmin() write first, and self-writes only
    // ever re-affirm it afterwards.
    function selfUpdateRoleIsValid(data) {
      let email = request.auth.token.email.lower();
      return (data.role == fixedRoleForEmail(email) ||
          data.role == resource.data.role ||
          isAdoptableAssignedRole(email, data.role)) &&
        (data.get('superAdmin', false) == (email in fixedSuperAdminEmails()) ||
          data.get('superAdmin', false) == resource.data.get('superAdmin', false));
    }

    // -------------------------------------------------------------------
    // Users directory (roles, profile info)
    // -------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      // Users may create/update their own profile (first login upsert), but
      // never with a self-granted role/superAdmin, and never a self-assigned
      // orgId (orgId is only ever set by an admin, e.g. org provisioning —
      // letting a user pick their own orgId would let them read any org's
      // record via the /organizations rule below).
      // Admins may create/update anyone else's profile — e.g. to change
      // roles, or when a super admin provisions a new org's admin — but
      // granting/revoking superAdmin itself is reserved to super admins.
      // The HR-manager branches are deliberately separate from the admin ones
      // rather than folded in behind isOrgAdmin(). An HR manager administers
      // one organisation, so on top of never granting `admin` or `superAdmin`
      // they may only act on users already in their own org, and may never
      // write an orgId — including onto their own profile, which would
      // otherwise move them into another company's data namespace and grant
      // read of its /organizations record.
      allow create: if isSignedIn() && (
        (request.auth.uid == uid &&
          selfCreateRoleIsValid(request.resource.data) &&
          !('orgId' in request.resource.data)) ||
        (isAdmin() && (request.resource.data.get('superAdmin', false) == false || isSuperAdmin())) ||
        (isHR() &&
          request.resource.data.role != 'admin' &&
          request.resource.data.get('superAdmin', false) == false &&
          request.resource.data.get('orgId', null) == myOrgId())
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == uid &&
          selfUpdateRoleIsValid(request.resource.data) &&
          request.resource.data.get('orgId', null) == resource.data.get('orgId', null)) ||
        (isAdmin() && (
          request.resource.data.get('superAdmin', false) == resource.data.get('superAdmin', false) ||
          isSuperAdmin()
        )) ||
        (isHR() &&
          // Cannot grant the admin role, nor edit anyone who already holds it —
          // so no self-promotion, and no demoting the admin who could undo it.
          request.resource.data.role != 'admin' &&
          resource.data.role != 'admin' &&
          request.resource.data.get('superAdmin', false) == false &&
          resource.data.get('superAdmin', false) == false &&
          // Target is in my org, and its orgId is left exactly as it was.
          resource.data.get('orgId', null) == myOrgId() &&
          request.resource.data.get('orgId', null) == resource.data.get('orgId', null))
      );
      // Admins can delete anyone. An HR manager may remove a user from their own
      // organisation, but never an admin. Profiles whose email is a fixed admin
      // are additionally protected in-app.
      allow delete: if isAdmin() ||
        (isHR() && resource.data.role != 'admin' && resource.data.get('orgId', null) == myOrgId());
    }

    // -------------------------------------------------------------------
    // Role assignments — an administrator granting a role to an email
    // before (or after) that person has an account. Consulted by
    // selfCreateRoleIsValid / selfUpdateRoleIsValid above, which is what
    // makes an assignment take effect at sign-in.
    //
    // Everything an org admin cannot do to a user profile, they cannot do
    // here either — otherwise this collection would be a way around the
    // /users rules. In particular `admin` is never assignable: that role is
    // granted directly on a profile by an existing admin, not through the
    // employee-directory flow this collection serves.
    // -------------------------------------------------------------------
    match /role_assignments/{emailId} {
      // Your own assignment (auth.tsx reads it at sign-in), or an
      // administrator's. Not `isSignedIn()`: that would let any employee
      // enumerate every colleague's address and pending role. The server-side
      // get() in assignedRoleFor() is unaffected by this — rule evaluation is
      // not subject to the caller's read permission.
      allow read: if isOrgAdmin() ||
        (isSignedIn() && emailId == request.auth.token.email.lower());
      allow create, update: if isOrgAdmin() &&
        request.resource.data.role in ['hr', 'manager', 'employee'] &&
        // The document id is the email, so an assignment can never be filed
        // under one address while naming another.
        request.resource.data.email == emailId &&
        // An HR manager may only assign within their own organisation.
        (isAdmin() || request.resource.data.get('orgId', null) == myOrgId());
      allow delete: if isOrgAdmin() &&
        (isAdmin() || resource.data.get('orgId', null) == myOrgId());
    }

    // -------------------------------------------------------------------
    // Employee links — which employee record an account is, keyed by uid.
    // Consulted by myEmployeeId() above, which is what makes "only your own
    // salary" mean anything.
    //
    // The write rule here is the whole security model: a user who could author
    // their own link would point it at the CEO's employeeId and read that
    // salary. So it is administrator-authored only, never self-written, and an
    // HR manager may only link accounts inside their own organisation.
    // -------------------------------------------------------------------
    match /employee_links/{uid} {
      // Your own link (so a client can resolve its own employeeId), or an
      // administrator's. Not isSignedIn(): the collection maps every colleague
      // to their employee record, and that is not a directory to hand out.
      allow read: if isOrgAdmin() || (isSignedIn() && uid == request.auth.uid);
      // Self-linking by an administrator is deliberately allowed: a link only
      // ever grants reads of one employee's own salary and leave, and an
      // administrator already reads every record in the org, so it escalates
      // nothing. Forbidding it would only strand a new organisation's first HR
      // account, which is the sole administrator able to link anyone.
      allow create, update: if isOrgAdmin() &&
        request.resource.data.uid == uid &&
        request.resource.data.employeeId is string &&
        request.resource.data.employeeId.size() > 0 &&
        (isAdmin() || request.resource.data.get('orgId', null) == myOrgId());
      allow delete: if isOrgAdmin() &&
        (isAdmin() || resource.data.get('orgId', null) == myOrgId());
    }

    // -------------------------------------------------------------------
    // Organizations — super-admin managed. Each org's own admin can read
    // (but not modify) their org's record.
    // -------------------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if isSignedIn() && (isSuperAdmin() || myProfile().orgId == orgId);
      allow create: if isSuperAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 &&
        request.resource.data.adminEmail is string &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------
    // Core HR data — read: any signed-in user, write: organisation
    // administrators (admins and HR managers, see isOrgAdmin()).
    // Adjust per-collection if employees need to self-service specific
    // actions (e.g. submitting their own leave/expense requests).
    // -------------------------------------------------------------------
    match /employees/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // Salary data lives in its own collection, split out of the
    // broadly-readable `employees` directory (see src/lib/seed.ts). The
    // document id is the employeeId, so `get` needs no field lookup.
    // Listing stays administrators-only: there is no per-employee compensation
    // query the app needs, and an employee reads their own by id.
    match /employee_compensation/{employeeId} {
      allow get: if inMyOrg() && (isOrgAdmin() || isSelf(employeeId));
      allow list: if isOrgAdmin() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /attendance/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // -------------------------------------------------------------------
    // Leave. Read: your own, your reports', or an organisation administrator's
    // (HR is the organisation administrator — isOrgAdmin, not isHR, so an org
    // whose administrator predates the `hr` role is not locked out; see
    // docs/document-management-spec.md §5).
    //
    // `read` is split into `get` and `list` throughout this block. Firestore
    // evaluates a list against every document the query returns and fails the
    // whole query if any one of them is disallowed, so a rule that depends on
    // `resource.data` only permits a query already filtered the same way. The
    // split makes that explicit instead of leaving an employee's own-records
    // query to fail mysteriously: list your own with
    // where('employeeId','==',...), your reports' with
    // where('managerChainIds','array-contains',...).
    // -------------------------------------------------------------------
    match /leave_requests/{docId} {
      allow get: if inMyOrg() && (isOrgAdmin() ||
        isSelf(resource.data.employeeId) ||
        managesSubject(resource.data));
      allow list: if inMyOrg() && (isOrgAdmin() ||
        isSelf(resource.data.employeeId) ||
        managesSubject(resource.data));

      // Employees can create/update their own leave requests; managers and
      // administrators decide them.
      allow create: if isSignedIn() && writingToMyOrg();
      allow update: if isSignedIn() && inMyOrg() && writingToMyOrg() &&
        (resource.data.employeeId == request.auth.uid || isManager());
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /leave_balances/{docId} {
      allow get: if inMyOrg() && (isOrgAdmin() ||
        isSelf(resource.data.employeeId) ||
        managesSubject(resource.data));
      allow list: if inMyOrg() && (isOrgAdmin() ||
        isSelf(resource.data.employeeId) ||
        managesSubject(resource.data));
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // -------------------------------------------------------------------
    // Salary. Read: the employee it belongs to, and organisation
    // administrators. Deliberately NOT managers — having reports does not
    // entitle someone to their pay, which is why `managesSubject` is absent
    // here and present on leave.
    //
    // Replaces `allow read: if isSignedIn()`, under which every signed-in
    // employee could read every colleague's gross, deductions and net pay.
    // `employee_compensation` was split out of `employees` precisely so the
    // broadly-readable directory would not carry salary (see src/lib/seed.ts);
    // payslips carry the same figures per month and had been left open.
    // -------------------------------------------------------------------
    match /payslips/{docId} {
      allow get: if inMyOrg() && (isOrgAdmin() || isSelf(resource.data.employeeId));
      allow list: if inMyOrg() && (isOrgAdmin() || isSelf(resource.data.employeeId));
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /payroll_runs/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /jobs/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /candidates/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /onboarding/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /goals/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /performance_reviews/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /expenses/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      // Employees can submit/edit their own expense claims; admins manage all.
      allow create: if isSignedIn() && writingToMyOrg();
      allow update: if isSignedIn() && inMyOrg() && writingToMyOrg() &&
        (resource.data.employeeId == request.auth.uid || isManager());
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /assets/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /billing_preferences/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      // Billing is company configuration, not per-user state.
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /billing_invoices/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      // Billing is company configuration, not per-user state.
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /helpdesk_tickets/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      // Employees can raise/update their own tickets; admins manage all.
      allow create: if isSignedIn() && writingToMyOrg();
      allow update: if isSignedIn() && inMyOrg() && writingToMyOrg() &&
        (resource.data.raisedById == request.auth.uid || isOrgAdmin());
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /regularizations/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isSignedIn() && writingToMyOrg();
      allow update: if isSignedIn() && inMyOrg() && writingToMyOrg() &&
        (resource.data.employeeId == request.auth.uid || isManager());
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // -------------------------------------------------------------------
    // Employee handbook.
    //
    // Read: any signed-in user. The handbook is organisation-wide policy and
    // is deliberately NOT narrowed by the per-employee visibility rules in
    // src/lib/dataScope.ts — an employee who can see nobody else's records
    // still reads it.
    //
    // Write: organisation administrators — HR managers and platform admins,
    // the same `isOrgAdmin()` every other collection here uses. HR is the role
    // that owns the handbook in practice, but confining the write to `isHR()`
    // would leave organisations created before the HR role existed — which
    // hold an `admin` rather than an `hr` account — with nobody able to publish
    // at all. See docs/document-management-spec.md §5.
    //
    // These rules are the actual authorization boundary for the module. The
    // client-side check in src/lib/handbook.ts decides whether to draw the
    // upload panel and reads a localStorage-backed directory to do it, so it
    // is an affordance, not a gate.
    // -------------------------------------------------------------------
    match /handbook_versions/{versionId} {
      allow read: if isSignedIn();
      allow create: if isOrgAdmin() &&
        // Attribution cannot be forged: the uploader is always the caller.
        request.resource.data.uploadedByUid == request.auth.uid &&
        // The client never names its own org.
        request.resource.data.get('orgId', null) == myOrgId() &&
        request.resource.data.id == versionId &&
        request.resource.data.contentType == 'application/pdf' &&
        request.resource.data.version is int &&
        request.resource.data.version > 0 &&
        request.resource.data.sizeBytes is int &&
        request.resource.data.sizeBytes > 0 &&
        // Mirrors HANDBOOK_MAX_BYTES in src/lib/handbookStorage.ts. The bytes
        // live in this document because no Cloud Storage bucket is provisioned
        // and Storage rules cannot read Firestore to check a role — see that
        // file's header. Firestore's own 1 MiB document ceiling is the
        // backstop; this keeps the payload clear of it.
        request.resource.data.sizeBytes <= 737280 &&
        request.resource.data.contentBase64 is string &&
        request.resource.data.contentBase64.size() <= 1000000 &&
        request.resource.data.fileName is string &&
        request.resource.data.fileName.size() > 0 &&
        request.resource.data.fileName.size() <= 200 &&
        request.resource.data.notes.size() <= 500;
      // Append-only. An audit trail that can be rewritten is not one, and
      // reverting a bad version is a pointer move, never a deletion.
      allow update, delete: if false;
    }

    match /handbook/{orgKey} {
      allow read: if isSignedIn();
      allow create, update: if isOrgAdmin() &&
        orgKey == myOrgKey() &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.currentVersionId is string &&
        // The pointer may only name a version that exists and belongs to my
        // org — otherwise an administrator of org A could publish org B's
        // handbook to their own employees.
        exists(/databases/$(database)/documents/handbook_versions/$(request.resource.data.currentVersionId)) &&
        get(/databases/$(database)/documents/handbook_versions/$(request.resource.data.currentVersionId))
          .data.get('orgId', null) == myOrgId();
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // Deny everything else by default.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
