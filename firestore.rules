rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'admin';
    }

    // Super admins can see/create organizations and are not scoped to any
    // single org (see src/lib/auth.tsx SUPER_ADMIN_EMAILS).
    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().superAdmin == true;
    }

    // An HR Manager administers their own organisation's people data. They hold
    // the same reach as an admin over the collections below, but are not
    // platform admins: they can never grant the `admin` role, touch an admin's
    // profile, or become a super admin. See isOrgAdmin() and the /users rules.
    function isHR() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'hr';
    }

    // Administrators of an organisation: platform admins and HR managers.
    function isOrgAdmin() {
      return isAdmin() || isHR();
    }

    // The caller's own organisation. Null for super admins and for the
    // legacy/default-org accounts that predate multi-org support, which is the
    // same value those orgs' user documents carry — so the comparisons in
    // /users below match default-org users for a default-org HR manager.
    function myOrgId() {
      return myProfile().get('orgId', null);
    }

    // -------------------------------------------------------------------
    // Which employee record a signed-in account *is*.
    //
    // Salary and leave documents are keyed by employeeId (`emp-001`), while
    // rules only ever see `request.auth.uid`. Nothing connected the two, which
    // is why the `resource.data.employeeId == request.auth.uid` checks this
    // file used to be written with never once evaluated true — they compared
    // `emp-009` to a Firebase uid. Every one of them is now `isSelf()`; the
    // last three (leave_requests, expenses and regularizations, all on
    // `update`) were missed when the rest were converted, so for a while an
    // employee could file a leave request or an expense claim and then never
    // edit or withdraw it, while the comment above each one said they could.
    //
    // Employee.authUid exists but lives in localStorage, so it is a claim the
    // client controls and could not be trusted here. The link is therefore an
    // administrator-authored document, exactly like /role_assignments: the
    // client does not say who it is, it discovers who an administrator said it
    // is. See /employee_links below and docs/salary-leave-access-spec.md §3.
    // -------------------------------------------------------------------
    function myEmployeeId() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/employee_links/$(request.auth.uid))
          ? get(/databases/$(database)/documents/employee_links/$(request.auth.uid)).data.employeeId
          : null;
    }

    /** True when `employeeId` is the caller's own employee record. */
    function isSelf(employeeId) {
      return employeeId != null && employeeId == myEmployeeId();
    }

    /**
     * True when the account a link is being written for belongs to my org.
     *
     * The /employee_links write rule needs this because its document id is
     * somebody's uid: without it, stamping the payload with your own orgId was
     * enough to rewrite an account in another organisation. See that block.
     *
     * A uid with no profile is nobody, and gets no link — which is also the
     * order the invite flow already writes in (users first, then the link, see
     * src/lib/accountInvites.ts) and the order the backfill reads in (it
     * iterates existing user documents, see src/lib/accessBackfill.ts).
     */
    function linkTargetInMyOrg(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        orgKeyOf(get(/databases/$(database)/documents/users/$(uid)).data) == myOrgKey();
    }

    /**
     * True when the caller is above `record` in the reporting tree.
     *
     * `managerChainIds` is denormalised onto the record at write time (see
     * src/lib/seed.ts): rules cannot walk `reportingManagerId`, because the
     * employee directory it lives in is localStorage-backed and unreadable
     * here. Without this, the only expressible tiers would be "own record" and
     * "any manager in the company", the latter being far wider than the
     * visibility rule in src/lib/dataScope.ts.
     */
    function managesSubject(record) {
      return myEmployeeId() != null &&
        myEmployeeId() in record.get('managerChainIds', []);
    }

    // -------------------------------------------------------------------
    // Multi-tenancy.
    //
    // Every data document carries an `orgId`, and every read and write is
    // scoped to the caller's own organisation. Before this, most collections
    // were `allow read: if isSignedIn()` with no orgId at all, so one company's
    // HR could read another company's employees, payroll and expenses.
    //
    // The key is a string, never null: accounts with no `orgId` — super admins
    // and the accounts predating multi-org support — resolve to 'default',
    // matching DEFAULT_ORG_KEY in src/lib/orgScope.ts and the same convention
    // the handbook already uses. A string is required because Firestore
    // equality filters do not match documents that are missing the field, so
    // `where('orgId','==',null)` would return nothing for un-backfilled data;
    // see the backfill in src/lib/orgBackfill.ts.
    // -------------------------------------------------------------------
    /**
     * The caller's organisation key.
     *
     * An account with no `orgId` is **unassigned**, and unassigned matches
     * nothing. It used to resolve to 'default', which made "not yet given an
     * organisation" and "a member of the incumbent organisation" the same
     * value — so a self-registered account landed inside the default tenant and
     * read its directory, attendance, jobs, expenses and assets. That sentinel
     * is right for a *document* written before multi-tenancy (see orgKeyOf) and
     * wrong for a *person*: a document with no orgId is legacy data, an account
     * with no orgId is a stranger.
     *
     * Safe to fail closed only because every legitimate default-org account now
     * carries `orgId: 'default'` explicitly — backfillIdentityOrgIds in
     * src/lib/orgBackfill.ts stamps them, and it must be run before this
     * deploys or those accounts lose access. See G7 in
     * docs/tenant-isolation-spec.md.
     *
     * Super admins keep 'default'. They deliberately carry no orgId — they
     * administer every organisation rather than belonging to one — and
     * isSuperAdmin() short-circuits the checks that matter, but a handful of
     * rules compare this value directly, and changing it for them would revoke
     * capabilities that have nothing to do with this.
     *
     * The sentinel contains no '__': the org_settings rule splits a document id
     * on that separator, and a sentinel containing it would compare as ''.
     */
    function myOrgKey() {
      return myOrgId() != null
        ? myOrgId()
        : (isSuperAdmin() ? 'default' : '~unassigned~');
    }

    /**
     * The organisation key of a stored or incoming document.
     *
     * Absent and explicitly-null `orgId` both resolve to 'default'. Absent is
     * the legacy shape of the 18 tenant collections; explicit null is the shape
     * the handbook writes for a legacy org (`handbookOrgId` returned
     * `profile?.orgId ?? null`). Reading them differently meant a handbook
     * version could never match its own organisation once these rules started
     * comparing, so one helper answers the question for every collection.
     */
    function orgKeyOf(data) {
      let stored = data.get('orgId', null);
      return stored == null ? 'default' : stored;
    }

    /**
     * True when the stored document belongs to the caller's organisation.
     *
     * Documents missing `orgId` are read as 'default' so legacy data stays
     * readable by the legacy org while the backfill runs, rather than every
     * existing record vanishing the moment these rules deploy.
     */
    function inMyOrg() {
      return isSuperAdmin() || orgKeyOf(resource.data) == myOrgKey();
    }

    /** True when the document being written is stamped with the caller's org. */
    function writingToMyOrg() {
      return isSuperAdmin() || orgKeyOf(request.resource.data) == myOrgKey();
    }

    // Managers, HR and admins can act on approval workflows.
    function isManager() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (myProfile().role == 'manager' || myProfile().role == 'hr' || myProfile().role == 'admin');
    }

    // Mirrors src/lib/auth.tsx ADMIN_EMAILS / SUPER_ADMIN_EMAILS (prod emails
    // only — E2E test emails are a client-side-only gate and are never
    // trusted here). Used so a self-write can never grant elevated access:
    // see selfCreateRoleIsValid / selfUpdateRoleIsValid below.
    function fixedAdminEmails() {
      return ['sumanthbolla97@gmail.com', 'saikrishnakoppaka@gmail.com', 'info@modconbuilders.com'];
    }
    function fixedSuperAdminEmails() {
      return ['saikrishnakoppaka@gmail.com'];
    }
    function fixedRoleForEmail(email) {
      return email in fixedAdminEmails() ? 'admin' : 'employee';
    }

    // A role an administrator has already granted to this email, recorded in
    // /role_assignments (written only by org admins — see that block below).
    // This is what lets an HR employee pick up their role on first sign-in
    // without the client being trusted to name its own role: the grant is a
    // document an admin authored, and the check happens here on the server.
    // `admin` is deliberately not adoptable this way — it is not something the
    // employee-directory flow hands out.
    function assignedRoleFor(email) {
      return exists(/databases/$(database)/documents/role_assignments/$(email))
        ? get(/databases/$(database)/documents/role_assignments/$(email)).data.role
        : null;
    }
    /** The organisation an assignment was filed by, or null if there is none. */
    function assignedOrgKeyFor(email) {
      return exists(/databases/$(database)/documents/role_assignments/$(email))
        ? orgKeyOf(get(/databases/$(database)/documents/role_assignments/$(email)).data)
        : null;
    }

    /**
     * A role this email may adopt at sign-in, on behalf of `orgKey`.
     *
     * `orgKey` is the whole point and used to be missing. The document id here
     * is an *email address*, so an HR manager of one organisation could file an
     * assignment against a person in another — stamping it with their own org,
     * which was the only thing the write rule checked — and that person would
     * adopt `hr` the next time they signed in. Their own orgId never changed,
     * so what they became was an administrator of the *victim's* organisation,
     * installed by a stranger. Same shape as the employee_links hole: a
     * collection keyed by somebody else's identifier, where only the payload's
     * org was ever checked.
     *
     * So an assignment is adoptable only by an account already in the
     * organisation that filed it. See the caller for why `create` passes null
     * and is safe doing so.
     */
    function isAdoptableAssignedRole(email, role, orgKey) {
      return role == assignedRoleFor(email) &&
        (role == 'hr' || role == 'manager' || role == 'employee') &&
        (orgKey == null || assignedOrgKeyFor(email) == orgKey);
    }

    // First-ever profile doc for an account: role/superAdmin must be the
    // safe default, a role an administrator assigned to this email, or the
    // value dictated by the hard-coded lists — a brand new sign-up can never
    // self-register as admin/super-admin.
    // A first profile carries no orgId — the create rule below forbids one, so
    // that it cannot be a self-service tenant switch. That is also why null is
    // passed for the organisation here rather than a key to match against:
    // there is nothing yet to match. Adopting `hr` at this point grants nothing
    // to anybody, because an account with no orgId resolves to '~unassigned~'
    // and every org-scoped rule compares against that and misses. The account
    // becomes real only when an administrator sets its orgId, and the /users
    // update rules let an HR manager do that solely for their own org.
    function selfCreateRoleIsValid(data) {
      let email = request.auth.token.email.lower();
      return (data.role == fixedRoleForEmail(email) ||
          isAdoptableAssignedRole(email, data.role, null)) &&
        data.get('superAdmin', false) == (email in fixedSuperAdminEmails());
    }

    // Resyncing an existing profile on a later sign-in: role/superAdmin may
    // only be what the fixed lists dictate, or left exactly as it already
    // was. A self-write can therefore never escalate past either baseline —
    // any actual promotion (e.g. Admin Dashboard granting `manager`) has to
    // land in the doc via an isAdmin() write first, and self-writes only
    // ever re-affirm it afterwards.
    function selfUpdateRoleIsValid(data) {
      let email = request.auth.token.email.lower();
      // The established profile's own organisation is what an assignment has to
      // have been filed by. `resource.data` and not `data`: the incoming write
      // cannot move itself into another org (the create/update rules pin orgId
      // either way), and reading the org off the payload would let the answer
      // be chosen by the same request it is meant to constrain.
      return (data.role == fixedRoleForEmail(email) ||
          data.role == resource.data.role ||
          isAdoptableAssignedRole(email, data.role, orgKeyOf(resource.data))) &&
        (data.get('superAdmin', false) == (email in fixedSuperAdminEmails()) ||
          data.get('superAdmin', false) == resource.data.get('superAdmin', false));
    }

    // -------------------------------------------------------------------
    // Users directory (roles, profile info)
    // -------------------------------------------------------------------
    match /users/{uid} {
      // Read: yourself, or an administrator with reach over the account.
      //
      // This was `allow read: if isSignedIn()`, which handed every signed-in
      // account of every organisation the whole platform's user directory —
      // each account's email, role, orgId and superAdmin flag. Nothing in the
      // app needed that: the only readers are the sign-in self-upsert
      // (src/lib/auth.tsx), the Admin dashboard, the org provisioning flow, and
      // the two backfills, all of which are self or administrator.
      //
      // get/list are split for the reason the leave block explains — a list is
      // evaluated against every document it returns, so an HR manager's query
      // must carry `where('orgId','==',...)` to be legal. A platform admin is
      // deliberately not org-scoped here: they administer every organisation,
      // which is the difference between `admin` and `hr`.
      //
      // Rule-internal get()s (myProfile, assignedRoleFor) are unaffected —
      // rule evaluation is not subject to the caller's read permission.
      allow get: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdmin() || isSuperAdmin() ||
        (isHR() && orgKeyOf(resource.data) == myOrgKey())
      );
      allow list: if isSignedIn() && (
        isAdmin() || isSuperAdmin() ||
        (isHR() && orgKeyOf(resource.data) == myOrgKey())
      );
      // Users may create/update their own profile (first login upsert), but
      // never with a self-granted role/superAdmin, and never a self-assigned
      // orgId (orgId is only ever set by an admin, e.g. org provisioning —
      // letting a user pick their own orgId would let them read any org's
      // record via the /organizations rule below).
      // Admins may create/update anyone else's profile — e.g. to change
      // roles, or when a super admin provisions a new org's admin — but
      // granting/revoking superAdmin itself is reserved to super admins.
      // The HR-manager branches are deliberately separate from the admin ones
      // rather than folded in behind isOrgAdmin(). An HR manager administers
      // one organisation, so on top of never granting `admin` or `superAdmin`
      // they may only act on users already in their own org, and may never
      // write an orgId — including onto their own profile, which would
      // otherwise move them into another company's data namespace and grant
      // read of its /organizations record.
      // An administrator creating an account for someone else must stamp it
      // with an organisation. Without that clause the invite flow could mint an
      // account that belongs to nobody — the exact shape G7 was about, arriving
      // by a different route. A self-create still carries no orgId, and must
      // not: naming your own organisation would be a self-service tenant
      // switch. That account simply reads nothing until an administrator
      // assigns it.
      allow create: if isSignedIn() && (
        (request.auth.uid == uid &&
          selfCreateRoleIsValid(request.resource.data) &&
          !('orgId' in request.resource.data)) ||
        (isAdmin() &&
          (request.resource.data.get('superAdmin', false) == false || isSuperAdmin()) &&
          request.resource.data.orgId is string &&
          request.resource.data.orgId.size() > 0) ||
        (isHR() &&
          request.resource.data.role != 'admin' &&
          request.resource.data.get('superAdmin', false) == false &&
          orgKeyOf(request.resource.data) == myOrgKey() &&
          request.resource.data.orgId is string)
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == uid &&
          selfUpdateRoleIsValid(request.resource.data) &&
          request.resource.data.get('orgId', null) == resource.data.get('orgId', null)) ||
        (isAdmin() && (
          request.resource.data.get('superAdmin', false) == resource.data.get('superAdmin', false) ||
          isSuperAdmin()
        )) ||
        (isHR() &&
          // Cannot grant the admin role, nor edit anyone who already holds it —
          // so no self-promotion, and no demoting the admin who could undo it.
          request.resource.data.role != 'admin' &&
          resource.data.role != 'admin' &&
          request.resource.data.get('superAdmin', false) == false &&
          resource.data.get('superAdmin', false) == false &&
          // Target is in my org, and its orgId is left exactly as it was.
          resource.data.get('orgId', null) == myOrgId() &&
          request.resource.data.get('orgId', null) == resource.data.get('orgId', null))
      );
      // Admins can delete anyone. An HR manager may remove a user from their own
      // organisation, but never an admin. Profiles whose email is a fixed admin
      // are additionally protected in-app.
      allow delete: if isAdmin() ||
        (isHR() && resource.data.role != 'admin' && resource.data.get('orgId', null) == myOrgId());
    }

    // -------------------------------------------------------------------
    // Role assignments — an administrator granting a role to an email
    // before (or after) that person has an account. Consulted by
    // selfCreateRoleIsValid / selfUpdateRoleIsValid above, which is what
    // makes an assignment take effect at sign-in.
    //
    // Everything an org admin cannot do to a user profile, they cannot do
    // here either — otherwise this collection would be a way around the
    // /users rules. In particular `admin` is never assignable: that role is
    // granted directly on a profile by an existing admin, not through the
    // employee-directory flow this collection serves.
    // -------------------------------------------------------------------
    match /role_assignments/{emailId} {
      // Your own assignment (auth.tsx reads it at sign-in), or an
      // administrator's. Not `isSignedIn()`: that would let any employee
      // enumerate every colleague's address and pending role. The server-side
      // get() in assignedRoleFor() is unaffected by this — rule evaluation is
      // not subject to the caller's read permission.
      allow read: if isOrgAdmin() ||
        (isSignedIn() && emailId == request.auth.token.email.lower());
      // Note what this does *not* require: that the assignment already stored
      // here was filed by my own organisation.
      //
      // That was tried, to stop one tenant restamping another's pending grant,
      // and it is the worse trade. Assignments are keyed by email and may
      // precede the account — that is how a new joiner picks up their role on
      // first sign-in — so whoever wrote first would own the address forever,
      // and an attacker could squat every address they could guess with no way
      // back that does not involve a platform admin.
      //
      // Last writer wins instead. The grant is inert until adopted and
      // adoption checks the organisation (isAdoptableAssignedRole), so the
      // damage a foreign write can do is bounded at overwriting a pending
      // grant that the rightful organisation can simply write again.
      allow create, update: if isOrgAdmin() &&
        request.resource.data.role in ['hr', 'manager', 'employee'] &&
        // The document id is the email, so an assignment can never be filed
        // under one address while naming another.
        request.resource.data.email == emailId &&
        // An HR manager may only assign within their own organisation.
        // orgKeyOf/myOrgKey rather than a raw `== myOrgId()`: the sentinel is
        // the same one every other collection compares, so a legacy assignment
        // and a stamped 'default' one are the same tenant. See G4 in
        // docs/tenant-isolation-spec.md.
        (isAdmin() || orgKeyOf(request.resource.data) == myOrgKey());
      allow delete: if isOrgAdmin() &&
        (isAdmin() || orgKeyOf(resource.data) == myOrgKey());
    }

    // -------------------------------------------------------------------
    // Employee links — which employee record an account is, keyed by uid.
    // Consulted by myEmployeeId() above, which is what makes "only your own
    // salary" mean anything.
    //
    // The write rule here is the whole security model: a user who could author
    // their own link would point it at the CEO's employeeId and read that
    // salary. So it is administrator-authored only, never self-written, and an
    // HR manager may only link accounts inside their own organisation.
    // -------------------------------------------------------------------
    match /employee_links/{uid} {
      // Your own link (so a client can resolve its own employeeId), or an
      // administrator's. Not isSignedIn(): the collection maps every colleague
      // to their employee record, and that is not a directory to hand out.
      allow read: if isOrgAdmin() || (isSignedIn() && uid == request.auth.uid);
      // Self-linking by an administrator is deliberately allowed: a link only
      // ever grants reads of one employee's own salary and leave, and an
      // administrator already reads every record in the org, so it escalates
      // nothing. Forbidding it would only strand a new organisation's first HR
      // account, which is the sole administrator able to link anyone.
      allow create, update: if isOrgAdmin() &&
        request.resource.data.uid == uid &&
        request.resource.data.employeeId is string &&
        request.resource.data.employeeId.size() > 0 &&
        // Same sentinel as everywhere else — see the role_assignments note.
        (isAdmin() || orgKeyOf(request.resource.data) == myOrgKey()) &&
        // ...and the account being linked is one of mine.
        //
        // Stamping the incoming document is not enough on its own, and this is
        // the only collection where that mattered: everywhere else the document
        // id is opaque, so `writingToMyOrg()` on the payload is the whole
        // question. Here the id *is* the victim — an HR manager who wrote
        // employee_links/{another org's uid} while stamping their **own** orgId
        // passed the line above, and silently re-pointed that account at any
        // employeeId they named. The escalation landed inside the victim's
        // tenant, not the attacker's: `myEmployeeId()` returns the named record
        // and the victim's own org scopes the read, so naming their CEO handed
        // the victim their CEO's payslips, and cost them their own.
        //
        // Checking the target's profile rather than the stored link is
        // deliberate — it is the same question `create` and `update` both need
        // answered, and a link whose stored orgId disagrees with its account's
        // is exactly the damage this repairs.
        (isAdmin() || linkTargetInMyOrg(uid));
      allow delete: if isOrgAdmin() &&
        (isAdmin() || orgKeyOf(resource.data) == myOrgKey());
    }

    // -------------------------------------------------------------------
    // Organizations — super-admin managed. Each org's own admin can read
    // (but not modify) their org's record.
    // -------------------------------------------------------------------
    match /organizations/{orgId} {
      // Compared against myOrgKey(), not `myProfile().orgId`: the latter errors
      // for an account with no orgId (a missing map key is not null in rules,
      // it fails evaluation), so every legacy account was denied rather than
      // simply not matching. It also lets the legacy tenant read
      // `organizations/default` if a record is ever created for it, which is
      // where its feature flags would live — see src/lib/features.ts.
      //
      // The org id is the wildcard, not a field, so this is safe on a document
      // that does not exist: nothing dereferences `resource`.
      allow read: if isSignedIn() && (isSuperAdmin() || orgId == myOrgKey());
      allow create: if isSuperAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 &&
        request.resource.data.adminEmail is string &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------
    // Subscription requests — the tenant's ONLY write in the billing feature,
    // and it grants nothing.
    //
    // The subscription itself lives on `organizations/{orgId}`, which is
    // super-admin-writable above. That is what makes a trial a trial: an
    // organisation cannot extend its own, mark itself paid, or comp itself,
    // however much of the client it rewrites.
    //
    // It also means a tenant cannot pay, so this is how they ask. An org
    // administrator creates a request — "we want to activate", "here is the
    // reference of the transfer we made" — and a super admin confirms it
    // against the payment provider's own dashboard before writing the term.
    //
    // The manual step is deliberate and it is honest about being manual: the
    // only trustworthy signal that money arrived is a signed webhook to a
    // server, and this project has no backend to receive one. Anything a
    // browser reports about a payment is a claim by the party who owes it.
    // -------------------------------------------------------------------
    match /subscription_requests/{docId} {
      // A tenant reads its own queue; a super admin reads every queue. A list
      // is evaluated per document, so an org's query MUST filter on orgId.
      allow get, list: if isSuperAdmin() || (isSignedIn() && inMyOrg());

      allow create: if isOrgAdmin() && writingToMyOrg() &&
        // Pinned, so a request cannot be created already actioned — which
        // would be a tenant granting itself whatever the queue grants.
        request.resource.data.status == 'open' &&
        request.resource.data.kind in ['activate', 'extend-trial', 'add-seats'] &&
        request.resource.data.requestedByUid == request.auth.uid &&
        request.resource.data.reference is string &&
        request.resource.data.reference.size() <= 200 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 1000;

      // Only the platform closes one. A tenant that could set its own request
      // to `actioned` would be marking its own payment received — which grants
      // nothing on its own, but it empties the queue the platform works from.
      allow update, delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------
    // Core HR data — read: any signed-in user, write: organisation
    // administrators (admins and HR managers, see isOrgAdmin()).
    // Adjust per-collection if employees need to self-service specific
    // actions (e.g. submitting their own leave/expense requests).
    // -------------------------------------------------------------------
    match /employees/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // Salary data lives in its own collection, split out of the
    // broadly-readable `employees` directory (see src/lib/seed.ts). The
    // document id is the employeeId, so `get` needs no field lookup.
    // Listing stays administrators-only: there is no per-employee compensation
    // query the app needs, and an employee reads their own by id.
    match /employee_compensation/{employeeId} {
      allow get: if inMyOrg() && (isOrgAdmin() || isSelf(employeeId));
      allow list: if isOrgAdmin() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /attendance/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // -------------------------------------------------------------------
    // Leave. Read: your own, your reports', or an organisation administrator's
    // (HR is the organisation administrator — isOrgAdmin, not isHR, so an org
    // whose administrator predates the `hr` role is not locked out; see
    // docs/document-management-spec.md §5).
    //
    // `read` is split into `get` and `list` throughout this block. Firestore
    // evaluates a list against every document the query returns and fails the
    // whole query if any one of them is disallowed, so a rule that depends on
    // `resource.data` only permits a query already filtered the same way. The
    // split makes that explicit instead of leaving an employee's own-records
    // query to fail mysteriously: list your own with
    // where('employeeId','==',...), your reports' with
    // where('managerChainIds','array-contains',...).
    // -------------------------------------------------------------------
    match /leave_requests/{docId} {
      allow get: if inMyOrg() && (isOrgAdmin() ||
        isSelf(resource.data.employeeId) ||
        managesSubject(resource.data));
      allow list: if inMyOrg() && (isOrgAdmin() ||
        isSelf(resource.data.employeeId) ||
        managesSubject(resource.data));

      // Employees can create/update their own leave requests; managers and
      // administrators decide them.
      allow create: if isSignedIn() && writingToMyOrg();
      allow update: if isSignedIn() && inMyOrg() && writingToMyOrg() &&
        (isSelf(resource.data.employeeId) || isManager());
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /leave_balances/{docId} {
      allow get: if inMyOrg() && (isOrgAdmin() ||
        isSelf(resource.data.employeeId) ||
        managesSubject(resource.data));
      allow list: if inMyOrg() && (isOrgAdmin() ||
        isSelf(resource.data.employeeId) ||
        managesSubject(resource.data));
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // -------------------------------------------------------------------
    // Salary. Read: the employee it belongs to, and organisation
    // administrators. Deliberately NOT managers — having reports does not
    // entitle someone to their pay, which is why `managesSubject` is absent
    // here and present on leave.
    //
    // Replaces `allow read: if isSignedIn()`, under which every signed-in
    // employee could read every colleague's gross, deductions and net pay.
    // `employee_compensation` was split out of `employees` precisely so the
    // broadly-readable directory would not carry salary (see src/lib/seed.ts);
    // payslips carry the same figures per month and had been left open.
    // -------------------------------------------------------------------
    match /payslips/{docId} {
      allow get: if inMyOrg() && (isOrgAdmin() || isSelf(resource.data.employeeId));
      allow list: if inMyOrg() && (isOrgAdmin() || isSelf(resource.data.employeeId));
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /payroll_runs/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /jobs/{docId} {
      // A published Open role is public, and has to be: the careers page
      // (src/pages/careers) is read by a candidate with no account in this
      // organisation, who could not have one — you do not get a login at a
      // company before it hires you.
      //
      // Only `status == 'Open'` is exposed, and only per document. A list is
      // evaluated against every row it returns, so an unauthenticated query
      // must filter on both `orgId` and `status` or it is denied whole rather
      // than trimmed — see usePublicJobOpenings.
      //
      // `.get('status', '')` rather than `.status`: a document with no status
      // field would error on the dereference, and an error denies the whole
      // rule including the signed-in clause beside it. The legacy openings
      // written before this field existed stay readable by their own org and
      // stay off the careers page, which is the right answer to both.
      allow get, list: if (isSignedIn() && inMyOrg()) ||
        resource.data.get('status', '') == 'Open';
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /candidates/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // -------------------------------------------------------------------
    // Job applications
    //
    // The only unauthenticated write path in this file. It exists because a
    // candidate applying for a job posted here has no account in this
    // organisation and cannot be given one before they are hired, so requiring
    // a sign-in would mean nobody outside the company could ever apply.
    //
    // What makes it safe is not authentication, it is the size of the hole.
    // The rule accepts exactly one shape of document, only against a job the
    // organisation has actually published as Open, only at a document id
    // recomputed here from the payload, and it grants no read whatsoever: an
    // applicant cannot read back what they wrote, cannot edit or delete it,
    // and cannot see anybody else's. The stage is pinned to 'Applied' and the
    // source to 'Website', so an applicant cannot arrive already shortlisted
    // or dressed up as an internal referral.
    //
    // What it cannot do is rate-limit — rules have no request counter. A flood
    // of applications under varying addresses will land, and this project has
    // already lost a day to an exhausted Firestore quota. App Check is the
    // real answer and is not provisioned on this project; until it is, the
    // deterministic id (one application per address per job) is the bound.
    // -------------------------------------------------------------------
    match /job_applications/{docId} {
      // The organisation's to read, never the applicant's. `isManager()` — so
      // managers, HR and admins — rather than `isOrgAdmin()`, because the
      // permission matrix gives Manager `view` on Recruitment and a hiring
      // manager who could open the pipeline but never see anyone in it would
      // be failing closed silently. Moving an application is still an
      // administrator's act: `view` is not permission to advance anybody.
      allow get, list: if isManager() && inMyOrg();

      // The public careers page. `submittedByUid` must be absent: it names a
      // signed-in account, and this caller is not one.
      allow create: if request.auth == null &&
        !request.resource.data.keys().hasAny(['submittedByUid']) &&
        request.resource.data.source == 'Website' &&
        validJobApplication(docId);

      // The Apply button inside the app: internal mobility, somebody who works
      // here applying for another role. Stamped with the caller and confined to
      // the caller's own organisation like every other signed-in write.
      allow create: if isSignedIn() && writingToMyOrg() &&
        request.resource.data.submittedByUid == request.auth.uid &&
        request.resource.data.source == 'Internal' &&
        validJobApplication(docId);

      // Moving an application through the pipeline. Two people may: an
      // administrator of the organisation, and the manager the job itself
      // names as its hiring manager — the person actually running that
      // shortlist, who otherwise had to ask HR to record every decision they
      // had already made.
      //
      // Named on *that* job, not "holds the Manager role": a manager in Sales
      // is not running the Engineering shortlist, and the permission matrix's
      // Manager entry is a client-side rendering decision that cannot be the
      // boundary here.
      //
      // Whatever the route, it changes nothing but the stage. Without the
      // affectedKeys() clause "advance to Interview" is also a licence to
      // rewrite the name, the address and the resume — which is not advancing
      // an application, it is replacing one person's with another's under the
      // same id.
      allow update: if inMyOrg() && writingToMyOrg() &&
        (isOrgAdmin() || isHiringManagerFor(resource.data.jobId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage']) &&
        request.resource.data.stage in
          ['Applied', 'Screening', 'Interview', 'Offer', 'Hired', 'Rejected'];

      allow delete: if isOrgAdmin() && inMyOrg();
    }

    /**
     * True when the caller is the manager the job `jobId` names as its own.
     *
     * `myEmployeeId()` — the administrator-authored `employee_links/{uid}`
     * document — never the client's claim about which employee it is. The
     * directory the app renders from is localStorage, so `hiringManagerId ==
     * <whatever this browser says I am>` would let anyone appoint themselves
     * to any shortlist. Same reasoning as isSelf(); see that block.
     *
     * An account with no link resolves to null, which matches no
     * `hiringManagerId` and so grants nothing. That is the right direction to
     * fail, but it is silent — the Recruitment page says so on screen rather
     * than just withholding the buttons.
     *
     * `isManager()` as well as the name match: the job's hiring manager field
     * can hold any employee id, including the HR administrator who posted it
     * or a department head who is a plain employee, and the pipeline is not
     * something an employee-role account should be able to move.
     *
     * The job is checked to be in the caller's organisation too. Employee ids
     * are per-org sequences — `emp-002` exists in every tenant — so without it
     * a manager linked to `emp-002` in one organisation would match another
     * organisation's job that happens to name the same id.
     */
    function isHiringManagerFor(jobId) {
      return isManager() &&
        jobId is string &&
        exists(/databases/$(database)/documents/jobs/$(jobId)) &&
        orgKeyOf(get(/databases/$(database)/documents/jobs/$(jobId)).data) == myOrgKey() &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.get('hiringManagerId', '') ==
          myEmployeeId();
    }

    /**
     * True when `jobId` is a role this organisation has published as Open.
     *
     * The anchor for the unauthenticated create: without it the write is an
     * open door onto a collection, and with it an applicant can only write
     * against something the organisation itself put on the careers page. The
     * org is taken from the payload and checked against the job's own, so
     * stamping a foreign orgId does not smuggle an application into another
     * tenant's pipeline.
     */
    function isPublishedOpenJob(orgId, jobId) {
      return exists(/databases/$(database)/documents/jobs/$(jobId)) &&
        orgKeyOf(get(/databases/$(database)/documents/jobs/$(jobId)).data) == orgId &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.get('status', '') == 'Open';
    }

    /**
     * The one shape of application document this collection accepts.
     *
     * `hasOnly` as well as `hasAll`: without the whitelist an applicant can
     * attach arbitrary extra fields to a document nobody is checking, and the
     * cheapest version of that is a megabyte of them. Every size limit here is
     * mirrored in src/lib/jobApplications.ts, where it is UX; this copy is the
     * one that holds, because a hostile client does not run the other.
     *
     * The document id is recomputed from the payload rather than trusted. It
     * is what makes "one application per address per job" true — a random id
     * would let one caller write documents without limit.
     */
    function validJobApplication(docId) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'orgId', 'jobId', 'jobTitle', 'name', 'email', 'phone',
          'experienceYears', 'source', 'stage', 'appliedOn', 'submittedAt',
          'resumeFileName', 'resumeContentType', 'resumeSizeBytes', 'resumeContentBase64'
        ]) &&
        d.keys().hasOnly([
          'orgId', 'jobId', 'jobTitle', 'name', 'email', 'phone', 'currentCompany',
          'experienceYears', 'coverNote', 'source', 'stage', 'appliedOn', 'submittedAt',
          'submittedByUid', 'resumeFileName', 'resumeContentType', 'resumeSizeBytes',
          'resumeContentBase64'
        ]) &&
        d.orgId is string && d.jobId is string &&
        docId == d.orgId + '__' + d.jobId + '__' + d.email &&
        // An application always arrives at the start of the pipeline. It says
        // nothing about how it did; the organisation says that.
        d.stage == 'Applied' &&
        d.email is string && d.email.size() <= 200 &&
        d.email == d.email.lower() &&
        d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 120 &&
        d.phone is string && d.phone.size() > 0 && d.phone.size() <= 32 &&
        d.jobTitle is string && d.jobTitle.size() <= 160 &&
        d.get('currentCompany', '') is string && d.get('currentCompany', '').size() <= 120 &&
        d.get('coverNote', '') is string && d.get('coverNote', '').size() <= 4000 &&
        d.experienceYears is int && d.experienceYears >= 0 && d.experienceYears <= 60 &&
        d.appliedOn is string && d.appliedOn.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        d.submittedAt is string && d.submittedAt.size() <= 40 &&
        // A resume is required, and it is a PDF. `RESUME_MAX_BYTES` is 720 KB;
        // base64 costs 4 bytes per 3, and Firestore's ceiling is 1 MiB for the
        // whole document, so the encoded string is capped just under that.
        d.resumeContentType == 'application/pdf' &&
        d.resumeFileName is string && d.resumeFileName.size() > 0 && d.resumeFileName.size() <= 200 &&
        d.resumeSizeBytes is int && d.resumeSizeBytes > 0 && d.resumeSizeBytes <= 737280 &&
        d.resumeContentBase64 is string && d.resumeContentBase64.size() <= 983040 &&
        isPublishedOpenJob(d.orgId, d.jobId);
    }

    match /onboarding/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /goals/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /performance_reviews/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /expenses/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      // Employees can submit/edit their own expense claims; admins manage all.
      allow create: if isSignedIn() && writingToMyOrg();
      allow update: if isSignedIn() && inMyOrg() && writingToMyOrg() &&
        (isSelf(resource.data.employeeId) || isManager());
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /assets/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /billing_preferences/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      // Billing is company configuration, not per-user state.
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /billing_invoices/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      // Billing is company configuration, not per-user state.
      allow create: if isOrgAdmin() && writingToMyOrg();
      // update/delete additionally check the stored document: without
      // inMyOrg() here, overwriting another org's record while stamping
      // your own orgId would be allowed, which is a takeover, not a write.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg();
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /helpdesk_tickets/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      // Employees can raise/update their own tickets; admins manage all.
      allow create: if isSignedIn() && writingToMyOrg();
      allow update: if isSignedIn() && inMyOrg() && writingToMyOrg() &&
        (resource.data.raisedById == request.auth.uid || isOrgAdmin());
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    match /regularizations/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create: if isSignedIn() && writingToMyOrg();
      allow update: if isSignedIn() && inMyOrg() && writingToMyOrg() &&
        (isSelf(resource.data.employeeId) || isManager());
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // -------------------------------------------------------------------
    // The Board — the organisation's own feed.
    //
    // What this replaces was a static array in src/data/common.ts: read-only,
    // identical for every tenant, and impossible for anyone inside a company
    // to add to. See src/lib/orgFeed.ts.
    //
    // The interesting rule is the reaction one. `reactions` is a map of
    // uid → emoji on the post, and an update may touch only the caller's own
    // key — so "you may react as yourself and nobody else" is a property of
    // the storage rather than of the button. A counter would let anybody
    // increment anything; a subcollection would need a second block and a
    // second read to say the same thing.
    // -------------------------------------------------------------------
    match /org_posts/{postId} {
      allow get, list: if isSignedIn() && inMyOrg();

      allow create: if isSignedIn() && writingToMyOrg() &&
        // Attribution cannot be forged.
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.kind in ['post', 'announcement', 'kudos'] &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 3000 &&
        // A post arrives with nobody's reaction on it and no replies.
        request.resource.data.reactions.size() == 0 &&
        request.resource.data.commentCount == 0 &&
        // Pinning is an administrator's act, including at creation — otherwise
        // anyone posts straight to the top of everybody's board.
        (request.resource.data.pinned == false || isOrgAdmin());

      allow update: if isSignedIn() && inMyOrg() && writingToMyOrg() && (
        reactingAsMyself() ||
        editingMyOwnPost() ||
        bumpingCommentCount() ||
        (isOrgAdmin() && onlyPinning())
      );

      // Your own, or an administrator clearing the board.
      allow delete: if isSignedIn() && inMyOrg() &&
        (resource.data.authorUid == request.auth.uid || isOrgAdmin());

      // Replies. Same tenant read, self-attributed writes, and a reply is
      // removable by the person who wrote it or by an administrator — not by
      // the post's author, who does not get to edit the conversation under
      // their own post.
      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 1000;
        allow update: if false;
        allow delete: if isSignedIn() &&
          (resource.data.authorUid == request.auth.uid || isOrgAdmin());
      }
    }

    /** Only the caller's own key in the reactions map moved. */
    function reactingAsMyself() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
        request.resource.data.reactions.diff(resource.data.reactions)
          .affectedKeys().hasOnly([request.auth.uid]) &&
        // A closed set, mirrored from REACTIONS in src/lib/orgFeed.ts. Without
        // it a "reaction" is arbitrary text stored on everyone's board.
        (!(request.auth.uid in request.resource.data.reactions) ||
          request.resource.data.reactions[request.auth.uid] in ['👍', '🎉', '❤️', '👏', '💡']);
    }

    /** The author rewording their own post. The body, and the edit marker. */
    function editingMyOwnPost() {
      return resource.data.authorUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt']) &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 3000;
    }

    /**
     * The denormalised reply count.
     *
     * Anyone in the organisation may move it, because anyone may reply — and
     * it is advisory. It cannot be used to edit a post, because the diff is
     * restricted to that one field.
     */
    function bumpingCommentCount() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
        request.resource.data.commentCount is int &&
        request.resource.data.commentCount >= 0;
    }

    function onlyPinning() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']);
    }

    // -------------------------------------------------------------------
    // Shared record collections — attendance, leave, assets, expenses,
    // helpdesk, payroll, onboarding.
    //
    // These lived in localStorage and nowhere else, which meant two people in
    // one company saw two unrelated datasets and a cleared cache was
    // unrecoverable data loss. See src/data/persistence.ts and
    // docs/shared-records-spec.md.
    //
    // One collection rather than nine, keyed `<orgKey>__<store>__<recordId>`,
    // with the record itself carried as a JSON string in `data`. Rules cannot
    // parse that string, so the two fields a rule needs — `employeeId` and
    // `status` — are lifted out to top-level by the writer.
    //
    // WHAT THIS BLOCK IS, PRECISELY. It is a **tenant** boundary: a signed-in
    // member of an organisation reads and writes that organisation's records
    // and no other organisation's, and the id cannot be forged to file a
    // record under a tenant the caller does not belong to. Plus the one
    // authority rule below, on leave.
    //
    // It is NOT yet a per-record authority boundary. Whether a ticket may be
    // edited by somebody who does not own it, or an expense approved by
    // somebody who is not a manager, is still decided in the client. That is a
    // real gap, written up in docs/shared-records-spec.md §5 — and it is
    // strictly more than existed before, when these records had no server at
    // all and every check was a hidden button.
    // -------------------------------------------------------------------
    match /org_records/{docId} {
      allow get, list: if isSignedIn() && inMyOrg();
      allow create, update: if isSignedIn() && writingToMyOrg() &&
        validOrgRecord(docId) &&
        leaveDecisionIsAuthorised();
      // Removal is a tombstone written through the same path, not a delete —
      // `get()` merges the seed back otherwise. A hard delete is an
      // administrator clearing data, which is what this allows.
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    function validOrgRecord(docId) {
      return request.resource.data.store is string &&
        request.resource.data.store.size() > 0 &&
        request.resource.data.recordId is string &&
        request.resource.data.recordId.size() > 0 &&
        request.resource.data.data is string &&
        // Firestore's ceiling is 1 MiB for the whole document; a single record
        // approaching that is a bug in the writer rather than a record.
        request.resource.data.data.size() <= 200000 &&
        // The id carries the tenant as well as the store, so a record cannot
        // be filed under one organisation while claiming another — the same
        // trick org_settings uses.
        docId == orgKeyOf(request.resource.data) + '__' +
                 request.resource.data.store + '__' +
                 request.resource.data.recordId;
    }

    /**
     * Only somebody with authority decides a leave request.
     *
     * The one per-record rule in this block, because leave is where the money
     * is: an approved day is a paid day, and unpaid absence is what payroll
     * deducts. `src/lib/dataScope.ts` computes the *precise* set — the
     * reporting line plus the administrators — and that computation needs the
     * org chart, which these rules cannot walk. So the server enforces the
     * coarse half that catches the case that matters: an ordinary employee
     * cannot move a request out of `Pending`, whether it is theirs or
     * somebody else's.
     *
     * Raising a request, cancelling your own, and every other store's writes
     * are untouched by this.
     */
    function leaveDecisionIsAuthorised() {
      return request.resource.data.store != 'leaveRequests' ||
        !('status' in request.resource.data) ||
        request.resource.data.status == 'Pending' ||
        request.resource.data.status == 'Cancelled' ||
        isManager();
    }

    // -------------------------------------------------------------------
    // Geofenced attendance — where each check-in and check-out was captured.
    //
    // This collection is the only reason the feature is worth anything. The
    // attendance records themselves are a localStorage overlay the employee's
    // own browser owns; a stamp its author can edit afterwards is not evidence
    // of anything. So four properties are enforced here and nowhere else:
    //
    //   1. A stamp is written by the employee it is about, and by nobody else
    //      (`isSelf`). A captured position is evidence that a particular
    //      person was somewhere; letting a third party produce one makes it an
    //      assertion again — the same reasoning that keeps Check In off other
    //      people's records in the UI.
    //   2. A stamp is IMMUTABLE to its author. There is no `update` an
    //      employee can make and no `delete` at all short of an org admin.
    //      A check-in recorded 4 km from the office stays recorded 4 km from
    //      the office. Everything else here is detail; this is the feature.
    //   3. `recordedAt` is `request.time`. The device's clock does not get a
    //      vote on when somebody arrived.
    //   4. A claim of `inside` is RECOMPUTED here against the organisation's
    //      own fence, read from `attendance_geofences/{orgKey}`. A client that
    //      posts `outcome: 'inside'` while sending coordinates in another city
    //      is refused, as is one naming a site the organisation never drew.
    //
    // What none of this proves is that the coordinates are TRUE. No browser
    // API can establish that, and these rules cannot either: they check the
    // arithmetic and the provenance of the fence, not of the position.
    // Mock-location detection is a set of heuristics recorded in `signals`,
    // and the finding that an employee falsified a position is a human's
    // (`review`), made after checking whether they were in the office. That is
    // why `review` is the one field an administrator may add, why it may only
    // be added to a stamp whose other fields stay byte-identical, and why the
    // employee the stamp is about can never write it.
    // -------------------------------------------------------------------
    match /attendance_stamps/{docId} {
      // Administrators read the organisation's stamps; an employee reads their
      // own. As with payslip_documents, the employee's query MUST filter on
      // employeeId as well as orgId — a list is evaluated against every
      // document it returns and fails whole otherwise.
      allow get: if inMyOrg() && (isOrgAdmin() || isSelf(resource.data.employeeId));
      allow list: if inMyOrg() && (isOrgAdmin() || isSelf(resource.data.employeeId));

      allow create: if isSignedIn() && writingToMyOrg() &&
        isSelf(request.resource.data.employeeId) &&
        validAttendanceStamp(docId);

      // The ONLY permitted update: an administrator attaching a review, with
      // every other field byte-identical to what is stored. Without the diff
      // check, "review this stamp" would double as "rewrite where it says I
      // was" for anyone who is also an org admin.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review']) &&
        validStampReview();

      // Never the employee, and never as a way to unsay a stamp: an admin can
      // remove one (a test record, a person who left), and that is all.
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // -------------------------------------------------------------------
    // The fences themselves, in a shape these rules can read.
    //
    // The app's own copy is `org_settings/<orgKey>__attendanceGeofence`, whose
    // payload is a JSON *string* — deliberately, so the org-settings sync can
    // treat every setting alike, and because nothing queries inside one. These
    // rules have no JSON parser, so that copy is unreadable here, and a rule
    // that cannot read the fence cannot check a claim against it.
    //
    // Hence this: a structured projection, one document per organisation,
    // written by `saveGeofenceConfig` in the same act as the settings copy. It
    // exists for `withinClaimedSite` below and for nothing else — the app never
    // reads it, so the two cannot drift into disagreeing about what the app
    // shows. If the projection is missing or stale, an `inside` claim is
    // refused: the fail-closed direction, and one an administrator fixes by
    // saving the fence again.
    // -------------------------------------------------------------------
    match /attendance_geofences/{orgKey} {
      // Readable by the org so an employee's client can verify it is looking at
      // the same fence the server will judge it against. It carries no personal
      // data — coordinates of the company's own offices.
      allow get: if isSignedIn() && (isSuperAdmin() || orgKey == myOrgKey());
      allow list: if isSignedIn() && inMyOrg();
      allow create, update: if isOrgAdmin() && writingToMyOrg() &&
        orgKey == orgKeyOf(request.resource.data) &&
        request.resource.data.sites is map &&
        request.resource.data.sites.size() <= 50;
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    /** The organisation's fence projection, or null when it has none. */
    function geofenceOf(orgKey) {
      return exists(/databases/$(database)/documents/attendance_geofences/$(orgKey))
        ? get(/databases/$(database)/documents/attendance_geofences/$(orgKey)).data
        : null;
    }

    /**
     * Squared metres between the submitted position and a site.
     *
     * Squared because these rules have no `sqrt` — `d² <= r²` answers "inside"
     * exactly as well as `d <= r`. The longitude scale factor cannot be
     * computed here either (no `cos`), so it is stored on the site by the
     * administrator who drew it and range-checked by `plausibleScale`. Mirrors
     * `squaredMetresBetween` in src/data/geofenceRules.ts — change the two
     * together, or the server will accept stamps the app refused.
     */
    function squaredMetres(lat, lng, site) {
      return ((lat - site.lat) * 110574) * ((lat - site.lat) * 110574) +
             ((lng - site.lng) * site.metresPerDegreeLng) * ((lng - site.lng) * site.metresPerDegreeLng);
    }

    /**
     * A site's stored scale factor is plausible for its latitude.
     *
     * Metres per degree of longitude is 111320·cos(lat): never negative, never
     * above the equatorial figure. A forged projection claiming a longitude
     * degree is worth ten metres would widen every fence by four orders of
     * magnitude — but only an org administrator can write the projection at
     * all, so this is a guard against a mistake rather than against an
     * outsider. The radius cap is the one that matters, and it is the same 500
     * m the app enforces.
     */
    function plausibleScale(site) {
      return site.metresPerDegreeLng is number &&
        site.metresPerDegreeLng >= 0 &&
        site.metresPerDegreeLng <= 111320 &&
        site.radiusMetres is number &&
        site.radiusMetres > 0 &&
        site.radiusMetres <= 500;
    }

    /**
     * The position is inside the site the stamp names, in the org's own fence.
     *
     * Reads the site out of the projection by the `siteId` the stamp claims,
     * so naming a site the organisation never drew fails on the `in` test
     * rather than passing with geometry the caller supplied.
     */
    function withinClaimedSite(orgKey) {
      return geofenceOf(orgKey) != null &&
        geofenceOf(orgKey).sites is map &&
        request.resource.data.siteId in geofenceOf(orgKey).sites &&
        plausibleScale(geofenceOf(orgKey).sites[request.resource.data.siteId]) &&
        squaredMetres(
          request.resource.data.lat,
          request.resource.data.lng,
          geofenceOf(orgKey).sites[request.resource.data.siteId]
        ) <= geofenceOf(orgKey).sites[request.resource.data.siteId].radiusMetres *
             geofenceOf(orgKey).sites[request.resource.data.siteId].radiusMetres;
    }

    /**
     * The claimed outcome agrees with the organisation's fence.
     *
     * Only `inside` is checked against the geometry, and that asymmetry is
     * deliberate: `inside` is the only claim worth forging. `outside`,
     * `inaccurate` and `unavailable` are claims against the employee's own
     * interest, and the two configuration outcomes describe the org rather
     * than the person — a stricter rule there would refuse honest stamps from
     * an organisation whose fence has since moved, which is a real event.
     */
    function outcomeMatchesFence(orgKey) {
      return request.resource.data.outcome != 'inside' ||
        (
          request.resource.data.lat is number &&
          request.resource.data.lng is number &&
          request.resource.data.siteId is string &&
          withinClaimedSite(orgKey)
        );
    }

    function validAttendanceStamp(docId) {
      return request.resource.data.id == docId &&
        // The id carries employee, day and kind, so a stamp cannot be filed
        // under one day while claiming another — and the determinism is what
        // makes a second check-in on the same day a refused create rather than
        // a silent overwrite of the first.
        docId == orgKeyOf(request.resource.data) + '__' +
                 request.resource.data.employeeId + '__' +
                 request.resource.data.date + '__' +
                 request.resource.data.kind &&
        // Attribution cannot be forged.
        request.resource.data.employeeUid == request.auth.uid &&
        // The moment is the server's, not the device's.
        request.resource.data.recordedAt == request.time &&
        request.resource.data.date is string &&
        request.resource.data.date.size() == 10 &&
        (request.resource.data.kind == 'in' || request.resource.data.kind == 'out') &&
        request.resource.data.outcome in
          ['inside', 'outside', 'no-sites', 'inaccurate', 'unavailable', 'exempt'] &&
        request.resource.data.mode in ['off', 'advisory', 'enforced'] &&
        request.resource.data.signals is list &&
        request.resource.data.signals.size() <= 10 &&
        // A stamp arrives unreviewed, always. Filing one that already carries
        // HR's blessing is the whole attack this feature is about.
        !('review' in request.resource.data) &&
        outcomeMatchesFence(orgKeyOf(request.resource.data));
    }

    function validStampReview() {
      return request.resource.data.review.verdict in ['genuine', 'falsified', 'inconclusive'] &&
        // The reviewer is the caller, and cannot be the person the stamp is
        // about — nobody clears their own flag.
        request.resource.data.review.reviewedByUid == request.auth.uid &&
        !isSelf(resource.data.employeeId) &&
        request.resource.data.review.note is string &&
        request.resource.data.review.note.size() <= 500;
    }

    // -------------------------------------------------------------------
    // Organisation configuration — leave policies, the company profile, the
    // holiday calendar, departments, the permission matrix, preferences.
    //
    // These lived only in localStorage, org-namespaced by a key suffix the
    // client owns. That made the tenant boundary for configuration a hygiene
    // property rather than an enforced one, and — the part that was not about
    // isolation at all — meant two administrators of the same organisation did
    // not share it, while leave accrual policy is what payroll deductions are
    // computed from. See G3 in docs/tenant-isolation-spec.md.
    //
    // Read is any signed-in member of the org: an employee's own leave page
    // needs the accrual policy and the holiday calendar. Write is
    // administrators, like every other piece of company configuration.
    // -------------------------------------------------------------------
    match /org_settings/{docId} {
      // `get` tests the document *id*, not `resource.data`, because the sync in
      // src/lib/orgSettings.ts subscribes before the document exists — a fresh
      // organisation has published nothing yet. For a non-existent document
      // `resource` is null, so `inMyOrg()` dereferences null and the rule fails
      // evaluation: every subscription is denied, and the feature silently does
      // not work. The id carries the tenant (`<orgKey>__<setting>`), which is
      // why it can answer the question without the document being there —
      // the same trick `handbook/{orgKey}` uses.
      allow get: if isSignedIn() && (isSuperAdmin() || docId.split('__')[0] == myOrgKey());
      // `list` keeps the field test: a query only ever returns documents that
      // exist, and the `where('orgId','==',...)` filter is what makes it legal.
      allow list: if isSignedIn() && inMyOrg();
      // The id encodes the tenant as well as the field, so a document cannot be
      // filed under one organisation while claiming another.
      // The id must agree with the document's own orgId, and writingToMyOrg()
      // decides which orgId that may be. Stated against the field rather than
      // myOrgKey() so a super admin — who administers every organisation and
      // switches between them in the UI — can still write the org they are
      // acting in, while an org administrator remains pinned to their own.
      allow create: if isOrgAdmin() && writingToMyOrg() &&
        request.resource.data.key is string &&
        request.resource.data.valueJson is string &&
        docId == orgKeyOf(request.resource.data) + '__' + request.resource.data.key;
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg() &&
        request.resource.data.valueJson is string &&
        // The id is immutable, so an update cannot re-file the document.
        request.resource.data.key == resource.data.key;
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    // -------------------------------------------------------------------
    // Employee handbook.
    //
    // Read: any signed-in user **of the owning organisation**. The handbook is
    // organisation-wide policy and is deliberately NOT narrowed by the
    // per-employee visibility rules in src/lib/dataScope.ts — an employee who
    // can see nobody else's records still reads it. It is narrowed by tenant:
    // `read: if isSignedIn()` let any signed-in account of any organisation
    // read any other organisation's handbook, and the version document carries
    // the PDF itself in `contentBase64`, so that was the whole document and not
    // just its metadata. The write side was scoped from the start, which is
    // what made the read side easy to miss.
    //
    // Write: organisation administrators — HR managers and platform admins,
    // the same `isOrgAdmin()` every other collection here uses. HR is the role
    // that owns the handbook in practice, but confining the write to `isHR()`
    // would leave organisations created before the HR role existed — which
    // hold an `admin` rather than an `hr` account — with nobody able to publish
    // at all. See docs/document-management-spec.md §5.
    //
    // These rules are the actual authorization boundary for the module. The
    // client-side check in src/lib/handbook.ts decides whether to draw the
    // upload panel and reads a localStorage-backed directory to do it, so it
    // is an affordance, not a gate.
    // -------------------------------------------------------------------
    match /handbook_versions/{versionId} {
      // Split get/list for the reason the leave block gives: a list is
      // evaluated against every document it returns, so `useHandbook` must
      // filter by orgId rather than fetch the collection and filter in JS.
      allow get: if isSignedIn() && inMyOrg();
      allow list: if isSignedIn() && inMyOrg();
      allow create: if isOrgAdmin() &&
        // Attribution cannot be forged: the uploader is always the caller.
        request.resource.data.uploadedByUid == request.auth.uid &&
        // The client never names its own org. `writingToMyOrg()` rather than a
        // bare `== myOrgId()` so a legacy org may stamp either the 'default'
        // sentinel or nothing at all, matching every other collection.
        writingToMyOrg() &&
        request.resource.data.id == versionId &&
        request.resource.data.contentType == 'application/pdf' &&
        request.resource.data.version is int &&
        request.resource.data.version > 0 &&
        request.resource.data.sizeBytes is int &&
        request.resource.data.sizeBytes > 0 &&
        // Mirrors HANDBOOK_MAX_BYTES in src/lib/handbookStorage.ts. The bytes
        // live in this document because no Cloud Storage bucket is provisioned
        // and Storage rules cannot read Firestore to check a role — see that
        // file's header. Firestore's own 1 MiB document ceiling is the
        // backstop; this keeps the payload clear of it.
        request.resource.data.sizeBytes <= 737280 &&
        request.resource.data.contentBase64 is string &&
        request.resource.data.contentBase64.size() <= 1000000 &&
        request.resource.data.fileName is string &&
        request.resource.data.fileName.size() > 0 &&
        request.resource.data.fileName.size() <= 200 &&
        request.resource.data.notes.size() <= 500;
      // Append-only. An audit trail that can be rewritten is not one, and
      // reverting a bad version is a pointer move, never a deletion.
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------
    // Payslip PDFs an administrator uploaded, one per employee per month.
    //
    // Read like /payslips and written like /handbook_versions, because it is
    // both: the figures are as private as the computed payslip they document —
    // an employee reads their own and nobody else's — and the payload is a PDF
    // whose size has to be bounded or it takes the document past Firestore's
    // 1 MiB ceiling. See src/lib/payslipDocuments.ts.
    // -------------------------------------------------------------------
    match /payslip_documents/{docId} {
      allow get: if inMyOrg() && (isOrgAdmin() || isSelf(resource.data.employeeId));
      // The list is legal only because the client filters on orgId, and for an
      // employee on employeeId as well: a list is evaluated against every
      // document it returns and fails whole if one is disallowed.
      allow list: if inMyOrg() && (isOrgAdmin() || isSelf(resource.data.employeeId));
      allow create: if isOrgAdmin() && writingToMyOrg() && validPayslipDocument(docId);
      // update additionally checks the stored document: without inMyOrg(),
      // overwriting another org's payslip while stamping your own orgId would
      // be allowed, which is a takeover, not a write. Update rather than
      // create-only because re-issuing a month is a correction, and the id is
      // deterministic so the correction lands on the document it corrects.
      allow update: if isOrgAdmin() && inMyOrg() && writingToMyOrg() && validPayslipDocument(docId);
      allow delete: if isOrgAdmin() && inMyOrg();
    }

    function validPayslipDocument(docId) {
      return request.resource.data.id == docId &&
        // Attribution cannot be forged: the uploader is always the caller.
        request.resource.data.uploadedByUid == request.auth.uid &&
        request.resource.data.employeeId is string &&
        request.resource.data.employeeId.size() > 0 &&
        // YYYY-MM. The id is built from it, so a malformed month would produce
        // a document that the month-scoped reads can never find again.
        request.resource.data.month is string &&
        request.resource.data.month.size() == 7 &&
        request.resource.data.contentType == 'application/pdf' &&
        request.resource.data.sizeBytes is int &&
        request.resource.data.sizeBytes > 0 &&
        // Mirrors PAYSLIP_MAX_BYTES in src/lib/payslipDocuments.ts, for the
        // reason given on handbook_versions above.
        request.resource.data.sizeBytes <= 737280 &&
        request.resource.data.contentBase64 is string &&
        request.resource.data.contentBase64.size() <= 1000000 &&
        request.resource.data.fileName is string &&
        request.resource.data.fileName.size() > 0 &&
        request.resource.data.fileName.size() <= 200;
    }

    /**
     * Documents filed against an employee — identity records and company paperwork.
     *
     * This library used to live in localStorage, which meant the rule about who
     * may file what was enforced by hiding a button. Anyone could put the button
     * back. It is stated here now, and src/lib/employeeDocuments.ts carries the
     * matching copy so the page offers the right controls; this block is what
     * decides.
     *
     * Reads stay org-wide rather than owner-only, matching what the app has
     * always shown: a profile's Documents tab is visible to whoever can open the
     * profile. Only metadata is stored — a name, a type, a status — never the
     * file, so this is a list of what was filed, not the contents.
     */
    match /employee_documents/{docId} {
      allow get: if isSignedIn() && inMyOrg();
      // Legal only because the client filters on orgId: a list is evaluated
      // against every document it returns and fails whole if one is disallowed.
      allow list: if isSignedIn() && inMyOrg();

      // A filed document always arrives unverified. It says nothing about
      // itself; an administrator says whether it checks out.
      allow create: if writingToMyOrg() &&
        validEmployeeDocument(docId) &&
        request.resource.data.uploadedByUid == request.auth.uid &&
        request.resource.data.status == 'Pending' &&
        mayFileEmployeeDocument(request.resource.data);

      // Two different writes land here, and they are not the same permission.
      //
      // Re-filing is the create rule again — the id is deterministic, so a
      // replacement lands on what it replaces — and it is still a filing, so it
      // still arrives Pending. Without that clause an employee re-files their
      // own PAN card as `status: 'Verified'` and has verified it themselves.
      //
      // Verifying is an administrator's call, changes nothing but the status,
      // and leaves the person who filed it as the person who filed it.
      //
      // Identity is pinned across both: otherwise "verify" is a rename, and a
      // rename across the primary boundary undoes the whole rule — file
      // anything as "Employment Contract", then call it "PAN Card".
      allow update: if inMyOrg() && writingToMyOrg() &&
        validEmployeeDocument(docId) &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.name == resource.data.name &&
        (
          (mayFileEmployeeDocument(request.resource.data) &&
            request.resource.data.uploadedByUid == request.auth.uid &&
            request.resource.data.status == 'Pending')
          ||
          (isAdmin() &&
            request.resource.data.uploadedByUid == resource.data.uploadedByUid)
        );

      allow delete: if isOrgAdmin() && inMyOrg();
    }

    /**
     * Which names are the employee's own identity and bank records.
     *
     * Mirrors PRIMARY_DOCUMENT_NAMES in src/lib/employeeDocuments.ts. Exact
     * matches, never a substring test: "Aadhaar Card Verification Note" is the
     * organisation's paperwork about the employee, not the employee's Aadhaar
     * card, and the two are filed by different people.
     */
    function isPrimaryDocumentName(name) {
      return name.lower().trim() in [
        'aadhaar card',
        'aadhar card',
        'pan card',
        'bank account details'
      ];
    }

    /**
     * Primary: the employee themselves, or HR on their behalf. Deliberately not
     * a platform admin — filing somebody else's PAN card is not their job.
     * Secondary: an administrator or HR, and not the employee.
     */
    function mayFileEmployeeDocument(data) {
      return isPrimaryDocumentName(data.name)
        ? (isHR() || isSelf(data.employeeId))
        : isOrgAdmin();
    }

    function validEmployeeDocument(docId) {
      return request.resource.data.id == docId &&
        // The id carries the org, so a document cannot be filed into one
        // organisation's namespace while claiming to belong to another.
        docId.split('__')[0] == request.resource.data.orgId &&
        request.resource.data.employeeId is string &&
        request.resource.data.employeeId.size() > 0 &&
        // Attribution is asserted by the callers above rather than here: on a
        // create and a re-file the filer must be the caller, but an
        // administrator verifying somebody else's document must leave their
        // name on it, so the two cannot share one clause.
        request.resource.data.uploadedByUid is string &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        request.resource.data.type is string &&
        request.resource.data.type.size() <= 20 &&
        request.resource.data.status in ['Verified', 'Pending', 'Expired'] &&
        // YYYY-MM-DD.
        request.resource.data.uploaded is string &&
        request.resource.data.uploaded.size() == 10 &&
        request.resource.data.size is string &&
        request.resource.data.size.size() <= 20;
    }

    match /handbook/{orgKey} {
      // The document id *is* the organisation key, so the tenant test is on the
      // id and needs no field lookup.
      allow read: if isSignedIn() && (isSuperAdmin() || orgKey == myOrgKey());
      allow create, update: if isOrgAdmin() &&
        orgKey == myOrgKey() &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.currentVersionId is string &&
        // The pointer may only name a version that exists and belongs to my
        // org — otherwise an administrator of org A could publish org B's
        // handbook to their own employees.
        exists(/databases/$(database)/documents/handbook_versions/$(request.resource.data.currentVersionId)) &&
        orgKeyOf(get(/databases/$(database)/documents/handbook_versions/$(request.resource.data.currentVersionId)).data)
          == myOrgKey();
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // Deny everything else by default.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
