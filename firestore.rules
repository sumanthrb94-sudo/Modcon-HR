rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Emails that are always administrators, independent of any stored
    // role. Mirrors ADMIN_EMAILS in src/lib/auth.tsx — keep both in sync.
    function isFixedAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'sumanthbolla97@gmail.com',
          'saikrishnakoppaka@gmail.com'
        ];
    }

    function isAdmin() {
      return isFixedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'admin'
      );
    }

    // -------------------------------------------------------------------
    // Users directory (roles, profile info)
    //
    // SECURITY: `role` on this document is exactly what isAdmin() reads, so
    // anyone able to write their own `role` can grant themselves admin over
    // every collection below. Self-writes must leave `role` untouched.
    // -------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();

      // First-login upsert. A user may create their own profile, but may not
      // hand themselves a privileged role on the way in; only the fixed
      // admin emails may self-create as 'admin'.
      allow create: if isSignedIn() && request.auth.uid == uid && (
        request.resource.data.role == 'employee' || isFixedAdmin()
      );

      // Admins may update anyone (e.g. to change roles). Everyone else may
      // update only their own profile, and only with `role` unchanged.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid &&
          request.resource.data.role == resource.data.role)
      );

      // Only admins can delete a user from the directory, and never a
      // profile whose email is a fixed admin (enforced in-app too).
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Core HR data — read: any signed-in user, write: admins only.
    //
    // KNOWN LIMITATION: the self-service rules below compare a record's
    // `employeeId` / `raisedById` against `request.auth.uid`. Those fields
    // hold directory ids ("emp-007"), never Firebase uids, so the owner
    // branch never matches and only admins can update these records. That
    // fails closed, which is the safe direction; wiring up real
    // self-service needs a `uid` field on each employee document to join
    // the auth identity to the directory record. Do not relax these to
    // `isSignedIn()` — that would let any user edit anyone's requests.
    // -------------------------------------------------------------------
    match /employees/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /leave_requests/{docId} {
      allow read: if isSignedIn();
      // Employees can create/update their own leave requests; admins can
      // manage all of them (e.g. approve/reject).
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.employeeId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /leave_balances/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payslips/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payroll_runs/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /jobs/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /candidates/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /onboarding/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /goals/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /performance_reviews/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /expenses/{docId} {
      allow read: if isSignedIn();
      // Employees can submit/edit their own expense claims; admins manage all.
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.employeeId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /assets/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /helpdesk_tickets/{docId} {
      allow read: if isSignedIn();
      // Employees can raise/update their own tickets; admins manage all.
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.raisedById == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /regularizations/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.employeeId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Deny everything else by default.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
