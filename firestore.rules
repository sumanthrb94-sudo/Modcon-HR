rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Emails that are always administrators, independent of any stored
    // role. Mirrors ADMIN_EMAILS in src/lib/auth.tsx — keep both in sync.
    function isFixedAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'sumanthbolla97@gmail.com',
          'saikrishnakoppaka@gmail.com'
        ];
    }

    // The directory record this account acts as, or '' when unlinked. This is
    // what makes owner-scoped reads expressible: the ownership fields below
    // hold directory ids ('emp-007'), which never equal request.auth.uid.
    function myEmployeeId() {
      return myProfile().get('employeeId', '');
    }

    function ownsRecord(field) {
      return isSignedIn() && myEmployeeId() != '' &&
        resource.data.get(field, '') == myEmployeeId();
    }

    // A self-set employeeId must belong to a record carrying this account's own
    // email. Without this the link IS the attack: point employeeId at a
    // colleague and every owner-scoped read below hands over their payslips.
    function employeeIdIsMine(eid) {
      return eid == null || (
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/employees/$(eid)) &&
        get(/databases/$(database)/documents/employees/$(eid)).data.email.lower()
          == request.auth.token.email.lower()
      );
    }

    function isAdmin() {
      return isFixedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'admin'
      );
    }

    // -------------------------------------------------------------------
    // Users directory (roles, profile info)
    //
    // SECURITY: `role` on this document is exactly what isAdmin() reads, so
    // anyone able to write their own `role` can grant themselves admin over
    // every collection below. Self-writes must leave `role` untouched.
    // -------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();

      // First-login upsert. A user may create their own profile, but may not
      // hand themselves a privileged role on the way in; only the fixed
      // admin emails may self-create as 'admin'.
      allow create: if isSignedIn() && request.auth.uid == uid &&
        (request.resource.data.role == 'employee' || isFixedAdmin()) &&
        employeeIdIsMine(request.resource.data.get('employeeId', null));

      // Admins may update anyone — that includes correcting an employeeId,
      // which is how an account with a personal email gets linked. Everyone
      // else may update only their own profile, with `role` unchanged and an
      // employeeId that resolves to their own email.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          employeeIdIsMine(request.resource.data.get('employeeId', null)))
      );

      // Only admins can delete a user from the directory, and never a
      // profile whose email is a fixed admin (enforced in-app too).
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Core HR data — read: any signed-in user, write: admins only.
    //
    // Ownership is resolved through users/{uid}.employeeId — the link the app
    // sets by matching the account's work email, and which only an admin may
    // point anywhere else. Before it existed these clauses compared a directory
    // id ("emp-007") against request.auth.uid and could never match, so
    // self-service silently never worked.
    //
    // Personal collections are read-scoped to their owner. Note this makes an
    // UNFILTERED list() illegal for an employee: Firestore evaluates a list
    // against every document it would return, so the client must carry a
    // matching where('employeeId','==',myId) clause. That is the intended
    // behaviour — it is what stops a bulk read of the company.
    //
    // Do not relax any of these to `isSignedIn()`; that hands every account
    // everyone else's records.
    // -------------------------------------------------------------------
    match /employees/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{docId} {
      // Personal records: an employee reads only their own. A list query must
      // therefore carry a matching where('employeeId','==',...) clause to be legal.
      allow read: if isAdmin() || ownsRecord('employeeId');
      allow write: if isAdmin();
    }

    match /leave_requests/{docId} {
      // Personal records: an employee reads only their own. A list query must
      // therefore carry a matching where('employeeId','==',...) clause to be legal.
      allow read: if isAdmin() || ownsRecord('employeeId');
      // Employees can create/update their own leave requests; admins can
      // manage all of them (e.g. approve/reject).
      // A created record must be attributed to the creator; otherwise any
      // account could file a request in a colleague's name.
      allow create: if isAdmin() ||
        (isSignedIn() && myEmployeeId() != '' &&
          request.resource.data.get('employeeId', '') == myEmployeeId());
      allow update: if isSignedIn() && (isAdmin() || ownsRecord('employeeId'));
      allow delete: if isAdmin();
    }

    match /leave_balances/{docId} {
      // Personal records: an employee reads only their own. A list query must
      // therefore carry a matching where('employeeId','==',...) clause to be legal.
      allow read: if isAdmin() || ownsRecord('employeeId');
      allow write: if isAdmin();
    }

    match /payslips/{docId} {
      // Personal records: an employee reads only their own. A list query must
      // therefore carry a matching where('employeeId','==',...) clause to be legal.
      allow read: if isAdmin() || ownsRecord('employeeId');
      allow write: if isAdmin();
    }

    match /payroll_runs/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /jobs/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /candidates/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /onboarding/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /goals/{docId} {
      // Personal records: an employee reads only their own. A list query must
      // therefore carry a matching where('employeeId','==',...) clause to be legal.
      allow read: if isAdmin() || ownsRecord('employeeId');
      allow write: if isAdmin();
    }

    match /performance_reviews/{docId} {
      // Personal records: an employee reads only their own. A list query must
      // therefore carry a matching where('employeeId','==',...) clause to be legal.
      allow read: if isAdmin() || ownsRecord('employeeId');
      allow write: if isAdmin();
    }

    match /expenses/{docId} {
      // Personal records: an employee reads only their own. A list query must
      // therefore carry a matching where('employeeId','==',...) clause to be legal.
      allow read: if isAdmin() || ownsRecord('employeeId');
      // Employees can submit/edit their own expense claims; admins manage all.
      // A created record must be attributed to the creator; otherwise any
      // account could file a request in a colleague's name.
      allow create: if isAdmin() ||
        (isSignedIn() && myEmployeeId() != '' &&
          request.resource.data.get('employeeId', '') == myEmployeeId());
      allow update: if isSignedIn() && (isAdmin() || ownsRecord('employeeId'));
      allow delete: if isAdmin();
    }

    match /assets/{docId} {
      // Kit is assigned to a person, so an employee sees only their own.
      allow read: if isAdmin() || ownsRecord('assignedToId');
      allow write: if isAdmin();
    }

    match /helpdesk_tickets/{docId} {
      // Personal records: an employee reads only their own. A list query must
      // therefore carry a matching where('raisedById','==',...) clause to be legal.
      allow read: if isAdmin() || ownsRecord('raisedById');
      // Employees can raise/update their own tickets; admins manage all.
      // A created record must be attributed to the creator; otherwise any
      // account could file a request in a colleague's name.
      allow create: if isAdmin() ||
        (isSignedIn() && myEmployeeId() != '' &&
          request.resource.data.get('raisedById', '') == myEmployeeId());
      allow update: if isSignedIn() && (isAdmin() || ownsRecord('raisedById'));
      allow delete: if isAdmin();
    }

    match /regularizations/{docId} {
      // Personal records: an employee reads only their own. A list query must
      // therefore carry a matching where('employeeId','==',...) clause to be legal.
      allow read: if isAdmin() || ownsRecord('employeeId');
      // A created record must be attributed to the creator; otherwise any
      // account could file a request in a colleague's name.
      allow create: if isAdmin() ||
        (isSignedIn() && myEmployeeId() != '' &&
          request.resource.data.get('employeeId', '') == myEmployeeId());
      allow update: if isSignedIn() && (isAdmin() || ownsRecord('employeeId'));
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Deny everything else by default.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
