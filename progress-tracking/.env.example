# Edge function secrets — set with: supabase secrets set --env-file .env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# --- extraction -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-
EXTRACTION_MODEL=claude-sonnet-4-5
# Anything below this auto-applies to the dashboard; below it goes to review.
# Start at 0.9, lower once the review queue is boring.
AUTO_APPLY_CONFIDENCE=0.8

# --- schema mapping (only if your tables are named differently) -------------
GOALS_TABLE=goals
EMPLOYEES_TABLE=employees

# --- channel secrets --------------------------------------------------------
# Generic caller auth for /extract-progress: openssl rand -hex 32
INGEST_SHARED_SECRET=

# ElevenLabs / voice post-call webhook
ELEVENLABS_WEBHOOK_SECRET=
VOICE_WEBHOOK_SECRET=

# Slack app → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=

# Resend inbound webhook (Svix), starts with whsec_
RESEND_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=

# --- browser -----------------------------------------------------------------
ALLOWED_ORIGIN=https://modcon-hr.vercel.app

# --- dispatcher --------------------------------------------------------------
DISPATCH_SHARED_SECRET=
DISPATCH_BATCH_LIMIT=50
# Set false if your team works weekends.
DISPATCH_SKIP_WEEKENDS=true

# Outbound check-ins
RESEND_API_KEY=re_
CHECKIN_FROM_EMAIL=ModCon HR <hr@modcon-hr.com>
UPDATES_EMAIL_DOMAIN=updates.modcon-hr.com
SLACK_BOT_TOKEN=xoxb-
ELEVENLABS_API_KEY=
CHECKIN_AGENT_ID=
CHECKIN_PHONE_NUMBER_ID=
